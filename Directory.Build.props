<Project>
  <PropertyGroup>
    <!-- Shared product version for the About page, Windows binaries, and Android package. -->
    <Version>1.0.0</Version>
    <RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</RepositoryRoot>
    <ArtifactsRoot>$(RepositoryRoot)artifacts\</ArtifactsRoot>
    <PublishArtifactsRoot>$(ArtifactsRoot)publish\</PublishArtifactsRoot>
  </PropertyGroup>

  <!-- Isolate intermediates and package locks for the two Native AOT engineering builds. -->
  <PropertyGroup Condition="'$(PmlWindowsAgentAotArtifactsPath)' != '' or '$(PmlWindowsUnifiedAotArtifactsPath)' != ''">
    <ArtifactsPath Condition="'$(PmlWindowsUnifiedAotArtifactsPath)' == ''">$(PmlWindowsAgentAotArtifactsPath)</ArtifactsPath>
    <ArtifactsPath Condition="'$(PmlWindowsUnifiedAotArtifactsPath)' != ''">$(PmlWindowsUnifiedAotArtifactsPath)</ArtifactsPath>
    <NuGetLockFilePath>$(ArtifactsPath)\obj\$(MSBuildProjectName)\packages.lock.json</NuGetLockFilePath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(PmlWindowsUnifiedAotArtifactsPath)' == '' and ('$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Agent' or '$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Frontend')">
    <Content Include="$(RepositoryRoot)PasswordManagerLocal.ico"
             Link="PasswordManagerLocal.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
