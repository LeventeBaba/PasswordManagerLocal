<Project>
  <PropertyGroup>
    <!-- Shared product version for the About page, Windows binaries, and Android package. -->
    <Version>1.0.0</Version>
    <RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</RepositoryRoot>
    <ArtifactsRoot>$(RepositoryRoot)artifacts\</ArtifactsRoot>
    <PublishArtifactsRoot>$(ArtifactsRoot)publish\</PublishArtifactsRoot>
  </PropertyGroup>

  <!-- Inherited by the EF design-time workspace as well as the publishing build. -->
  <PropertyGroup Condition="'$(PmlWindowsAgentAotArtifactsPath)' != ''">
    <ArtifactsPath>$(PmlWindowsAgentAotArtifactsPath)</ArtifactsPath>
    <NuGetLockFilePath>$(ArtifactsPath)\obj\$(MSBuildProjectName)\packages.lock.json</NuGetLockFilePath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Agent' or '$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Frontend'">
    <Content Include="$(RepositoryRoot)PasswordManagerLocal.ico"
             Link="PasswordManagerLocal.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
