<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PasswordManagerLocal.Windows.Tests.IPC</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Windows.Tests.IPC</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPC\PasswordManagerLocal.Windows.Ipc.csproj" />
    <ProjectReference Include="..\EndpointRpc\Contracts\PasswordManagerLocal.Windows.EndpointRpc.Contracts.csproj" />
    <ProjectReference Include="..\EndpointRpc\Client\PasswordManagerLocal.Windows.EndpointRpc.Client.csproj" />
    <ProjectReference Include="..\EndpointRpc\Server\PasswordManagerLocal.Windows.EndpointRpc.Server.csproj" />
    <ProjectReference Include="..\..\Common\Backend\PasswordManagerLocal.Common.Backend.csproj" />
    <ProjectReference Include="..\Agent\PasswordManagerLocal.Windows.Agent.csproj" />
    <ProjectReference Include="..\Frontend\PasswordManagerLocal.Windows.Frontend.csproj" />
    <ProjectReference Include="..\Packaging\PasswordManagerLocal.Windows.Packaging.csproj" />
    <ProjectReference Include="..\Tests.Host\PasswordManagerLocal.Windows.Tests.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <ProcessTestHostPlatformSegment Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">$(Platform)\</ProcessTestHostPlatformSegment>
    <ProcessTestHostOutputDirectory>$(MSBuildProjectDirectory)\..\Tests.Host\bin\$(ProcessTestHostPlatformSegment)$(Configuration)\net10.0-windows\</ProcessTestHostOutputDirectory>
  </PropertyGroup>

  <Target Name="CopyWindowsProcessTestHost" AfterTargets="Build">
    <ItemGroup>
      <ProcessTestHostFile Include="$(ProcessTestHostOutputDirectory)**\*"
                           Exclude="$(ProcessTestHostOutputDirectory)**\*.pdb;$(ProcessTestHostOutputDirectory)**\*.xml" />
    </ItemGroup>
    <Error Condition="'@(ProcessTestHostFile)' == ''"
           Text="The Windows process test host output was not found at $(ProcessTestHostOutputDirectory)." />
    <Copy SourceFiles="@(ProcessTestHostFile)"
          DestinationFiles="@(ProcessTestHostFile->'$(OutDir)TestHosts\ProcessLockHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
    <ProjectReference Include="..\..\Common\Preferences\PasswordManagerLocal.Common.Preferences.csproj" />
  </ItemGroup>

</Project>
