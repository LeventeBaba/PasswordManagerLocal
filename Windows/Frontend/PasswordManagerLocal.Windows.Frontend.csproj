<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PasswordManagerLocal</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Windows.Frontend</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64;x86;ARM64;ARM32</Platforms>
    <SignAssembly>False</SignAssembly>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepositoryRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <!-- Keep Windows releases self-contained and use conservative partial trimming.
         Partial trimming removes trim-compatible framework code while preserving
         application and third-party assemblies that rely on reflection or XAML. -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Release builds do not attach a debugger, create crash dumps, emit EventSource
         events/metrics, or use HTTP/3. Keep normal exception messages and stack-trace
         behavior, but let the trimmer remove these unused diagnostics features. -->
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <Http3Support>false</Http3Support>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>true</StackTraceSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <!-- The frontend application assemblies use XAML activation, generated JSON
         metadata, and reflection. Preserve the UI/client boundary assemblies while
         still trimming the self-contained framework and trim-compatible dependencies.
         EndpointRpc Contracts is also rooted because its DTO surface participates in
         generated IPC serialization. SharedRuntimeTrimming.targets applies direct copyused actions only when the
         first staged publication proves that a shared managed file differs. -->
    <TrimmerRootAssembly Include="PasswordManagerLocal.Common.Frontend" />
    <TrimmerRootAssembly Include="PasswordManagerLocal.Windows.EndpointRpc.Client" />
    <TrimmerRootAssembly Include="PasswordManagerLocal.Windows.EndpointRpc.Contracts" />
    <TrimmerRootAssembly Include="ReactiveUI" />
    <TrimmerRootAssembly Include="ReactiveUI.Avalonia" />
    <TrimmerRootAssembly Include="ReactiveUI.Primitives" />
    <TrimmerRootAssembly Include="ReactiveUI.Primitives.Avalonia" />
    <TrimmerRootAssembly Include="Splat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Frontend\PasswordManagerLocal.Common.Frontend.csproj" />
    <ProjectReference Include="..\..\Common\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
    <ProjectReference Include="..\EndpointRpc\Client\PasswordManagerLocal.Windows.EndpointRpc.Client.csproj" />
    <ProjectReference Include="..\IPC\PasswordManagerLocal.Windows.Ipc.csproj" />
    <ProjectReference Include="..\Agent\PasswordManagerLocal.Windows.Agent.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Tools\ConfigureWindowsFirewall.bat" Link="ConfigureWindowsFirewall.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tools\ConfigureWindowsFirewall.ps1" Link="ConfigureWindowsFirewall.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="OptimizeWindowsReleasePublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true' and '$(PublishDir)' != ''">
    <!-- PublishDir normally ends in a directory separator. Passing that value as a
         quoted native-process argument can consume the closing quote and the next
         named PowerShell parameter. Normalize it before crossing that boundary. -->
    <PropertyGroup>
      <WindowsPublishOptimizationPath>$([System.IO.Path]::TrimEndingDirectorySeparator('$(PublishDir)'))</WindowsPublishOptimizationPath>
    </PropertyGroup>
    <!-- The Avalonia package currently marks its designer protocol as runtime assets,
         and the CoreCLR runtime pack includes dump/debugger tools by default. The
         canonical Windows publish does not use either feature set, so post-process
         the folder and its generated .deps.json together. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Tools\OptimizeWindowsPublish.ps1&quot; -OutputPath &quot;$(WindowsPublishOptimizationPath)&quot; -DependencyManifestFileName &quot;PasswordManagerLocal.deps.json&quot; -RemoveAvaloniaDesignerAssets" />
  </Target>

  <Import Project="..\Packaging\SharedRuntimeTrimming.targets" />

</Project>
