<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PasswordManagerLocal.Windows.Agent</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Windows.Agent</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64;x86;ARM64;ARM32</Platforms>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <!-- The Agent is independently published and validated before the two outputs are
         merged. Partial trimming is intentionally conservative for EF Core/SQLite and
         the hosting stack while still trimming the self-contained runtime and all
         trim-compatible dependencies. No assembly-wide roots or ILLink suppressions
         are required by the current explicit EndpointRpc dispatch/source-generated
         serializer architecture. -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>

    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <Http3Support>false</Http3Support>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>true</StackTraceSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Backend\PasswordManagerLocal.Common.Backend.csproj" />
    <ProjectReference Include="..\..\Common\Backend.Hosting\PasswordManagerLocal.Common.Backend.Hosting.csproj" />
    <ProjectReference Include="..\Backend\PasswordManagerLocal.Windows.Backend.csproj" />
    <ProjectReference Include="..\..\Common\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
    <ProjectReference Include="..\..\Common\Preferences\PasswordManagerLocal.Common.Preferences.csproj" />
    <ProjectReference Include="..\EndpointRpc\Server\PasswordManagerLocal.Windows.EndpointRpc.Server.csproj" />
    <ProjectReference Include="..\IPC\PasswordManagerLocal.Windows.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Localization\*.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PasswordManagerLocal.Windows.Tests.IPC" />
  </ItemGroup>
  <Target Name="OptimizeWindowsAgentReleasePublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true' and '$(PublishDir)' != ''">
    <!-- PublishDir normally ends in a directory separator. Passing that value as a
         quoted native-process argument can consume the closing quote and the next
         named PowerShell parameter. Normalize it before crossing that boundary. -->
    <PropertyGroup>
      <WindowsPublishOptimizationPath>$([System.IO.Path]::TrimEndingDirectorySeparator('$(PublishDir)'))</WindowsPublishOptimizationPath>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Tools\OptimizeWindowsPublish.ps1&quot; -OutputPath &quot;$(WindowsPublishOptimizationPath)&quot; -DependencyManifestFileName &quot;PasswordManagerLocal.Windows.Agent.deps.json&quot; -RemoveUnusedXmlSerializerAssembly" />
  </Target>

  <Import Project="..\Packaging\SharedRuntimeTrimming.targets" />

</Project>
