<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <OutputName>PasswordManagerLocal</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US;hu-HU</Cultures>
    <DefineConstants>$(DefineConstants);ProductVersion=$(Version);PmlProductCode=$(PmlProductCode);LicenseRtf=$(PmlLicenseRtf);WindowsInstallationScript=$(PmlWindowsInstallationScript)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
    <BindPath Include="$(PmlProductDirectory)" BindName="Product" />
    <BindPath Include="$(RepositoryRoot)" BindName="Repository" />
    <BindPath Include="$(PmlWindowsIconDirectory)" BindName="Branding" />
  </ItemGroup>

  <Target Name="ValidateInstallerInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(PmlProductDirectory)' == '' or !Exists('$(PmlProductDirectory)\PasswordManagerLocal.exe')"
           Text="Build the installer through publish.cmd -W with a verified Windows product." />
    <Error Condition="'$(PmlProductCode)' == ''"
           Text="The installer publisher must provide one product code for both languages." />
    <Error Condition="'$(PmlLicenseRtf)' == '' or !Exists('$(PmlLicenseRtf)')"
           Text="The generated installer license is missing." />
    <Error Condition="'$(PmlWindowsInstallationScript)' == ''"
           Text="The installer maintenance script input is missing." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,5}$'))"
           Text="The central app version must have three numeric fields for Windows Installer." />
    <PropertyGroup>
      <_InstallerVersion>$([System.Version]::Parse('$(Version)'))</_InstallerVersion>
    </PropertyGroup>
    <Error Condition="$([System.Version]::Parse('$(_InstallerVersion)').Major) &gt; 255 or $([System.Version]::Parse('$(_InstallerVersion)').Minor) &gt; 255 or $([System.Version]::Parse('$(_InstallerVersion)').Build) &gt; 65535"
           Text="The central app version exceeds Windows Installer's 255.255.65535 limit." />
  </Target>
</Project>
