<Project>
  <PropertyGroup>
    <PmlIconSvg>$(RepositoryRoot)PasswordManagerLocal.svg</PmlIconSvg>
    <PmlIconGeometryTransform>$(RepositoryRoot)Tools/Branding/SvgPathGeometry.xslt</PmlIconGeometryTransform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Frontend' or
                            '$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Installer' or
                            ('$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Agent' and '$(PmlWindowsUnifiedNativeAot)' != 'true') or
                            ('$(MSBuildProjectName)' == 'PasswordManagerLocal.Common.Frontend' and '$(PmlWindowsUnifiedNativeAot)' == 'true')">
    <PmlWindowsIconGenerator>$(RepositoryRoot)Tools/Windows/GenerateWindowsIcon.ps1</PmlWindowsIconGenerator>
    <PmlIconPowerShell Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell.exe</PmlIconPowerShell>
    <PmlIconPowerShell Condition="'$(PmlIconPowerShell)' == ''">pwsh</PmlIconPowerShell>
  </PropertyGroup>
  <ItemGroup Condition="'$(PmlWindowsIconGenerator)' != ''">
    <UpToDateCheckInput Include="$(PmlIconSvg);$(PmlWindowsIconGenerator)" Set="PmlWindowsIcon" />
    <UpToDateCheckOutput Include="$(PmlWindowsIconFile)" Set="PmlWindowsIcon" />
    <UpToDateCheckInput Include="$(PmlWindowsIconFile)" />
  </ItemGroup>
  <Target Name="GeneratePmlWindowsIcon"
          BeforeTargets="PrepareForBuild;CoreCompile;GetCopyToOutputDirectoryItems"
          Condition="'$(PmlWindowsIconGenerator)' != '' and '$(DesignTimeBuild)' != 'true'"
          Inputs="$(PmlIconSvg);$(PmlWindowsIconGenerator)"
          Outputs="$(PmlWindowsIconFile)">
    <Exec Command="$(PmlIconPowerShell) -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(PmlWindowsIconGenerator)&quot; -SvgPath &quot;$(PmlIconSvg)&quot; -IconPath &quot;$(PmlWindowsIconFile)&quot;" />
  </Target>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PasswordManagerLocal.Android.Frontend'">
    <PmlAndroidIconTransform>$(RepositoryRoot)Tools/Android/GenerateAdaptiveIcon.xslt</PmlAndroidIconTransform>
    <PmlAndroidIconDirectory>$(IntermediateOutputPath)pml-branding/</PmlAndroidIconDirectory>
    <PmlAndroidIconFile>$(PmlAndroidIconDirectory)ic_launcher.xml</PmlAndroidIconFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(PmlAndroidIconTransform)' != ''">
    <AndroidResource Include="$(PmlAndroidIconFile)" LogicalName="mipmap-anydpi-v26/ic_launcher.xml" />
    <UpToDateCheckInput Include="$(PmlIconSvg);$(PmlAndroidIconTransform);$(PmlIconGeometryTransform)" Set="PmlAndroidIcon" />
    <UpToDateCheckOutput Include="$(PmlAndroidIconFile)" Set="PmlAndroidIcon" />
  </ItemGroup>
  <Target Name="GeneratePmlAndroidIcon"
          BeforeTargets="_ComputeAndroidResourcePaths"
          Condition="'$(PmlAndroidIconTransform)' != ''"
          Inputs="$(PmlIconSvg);$(PmlAndroidIconTransform);$(PmlIconGeometryTransform)"
          Outputs="$(PmlAndroidIconFile)">
    <MakeDir Directories="$(PmlAndroidIconDirectory)" />
    <XslTransformation XmlInputPaths="$(PmlIconSvg)"
                       XslInputPath="$(PmlAndroidIconTransform)"
                       OutputPaths="$(PmlAndroidIconFile).tmp" />
    <Move SourceFiles="$(PmlAndroidIconFile).tmp" DestinationFiles="$(PmlAndroidIconFile)" />
    <ItemGroup>
      <FileWrites Include="$(PmlAndroidIconFile);$(PmlAndroidIconFile).tmp" />
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PasswordManagerLocal.Common.Frontend'">
    <PmlAboutIconTransform>$(RepositoryRoot)Tools/Branding/GenerateAboutIcon.xslt</PmlAboutIconTransform>
    <PmlAboutIconDirectory>$(IntermediateOutputPath)pml-branding/</PmlAboutIconDirectory>
    <PmlAboutIconFile>$(PmlAboutIconDirectory)AppIcon.axaml</PmlAboutIconFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(PmlAboutIconTransform)' != ''">
    <AvaloniaXaml Include="$(PmlAboutIconFile)" Link="Assets/Icons/AppIcon.axaml" />
    <UpToDateCheckInput Include="$(PmlIconSvg);$(PmlAboutIconTransform);$(PmlIconGeometryTransform)" Set="PmlAboutIcon" />
    <UpToDateCheckOutput Include="$(PmlAboutIconFile)" Set="PmlAboutIcon" />
  </ItemGroup>
  <Target Name="GeneratePmlAboutIcon"
          BeforeTargets="GenerateAvaloniaResources"
          Condition="'$(PmlAboutIconTransform)' != ''"
          Inputs="$(PmlIconSvg);$(PmlAboutIconTransform);$(PmlIconGeometryTransform)"
          Outputs="$(PmlAboutIconFile)">
    <MakeDir Directories="$(PmlAboutIconDirectory)" />
    <XslTransformation XmlInputPaths="$(PmlIconSvg)"
                       XslInputPath="$(PmlAboutIconTransform)"
                       OutputPaths="$(PmlAboutIconFile).tmp" />
    <Move SourceFiles="$(PmlAboutIconFile).tmp" DestinationFiles="$(PmlAboutIconFile)" />
    <ItemGroup>
      <FileWrites Include="$(PmlAboutIconFile);$(PmlAboutIconFile).tmp" />
    </ItemGroup>
  </Target>

  <!-- Keep C# trace calls out of Release. WiX uses DefineConstants for its own
       semicolon-delimited preprocessor inputs. -->
  <Target Name="DisableReleaseTraceLogging" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DefineConstants>$([System.Text.RegularExpressions.Regex]::Replace('$(DefineConstants)', '(^|[;,\s])TRACE(?=$|[;,\s])', '$1'))</DefineConstants>
    </PropertyGroup>
  </Target>

  <!-- Windows releases must go through the product publisher for layout verification and packaging. -->
  <Target Name="RequireWindowsProductPublisher"
          BeforeTargets="Publish"
          Condition="('$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Frontend' or '$(MSBuildProjectName)' == 'PasswordManagerLocal.Windows.Agent') and '$(PmlWindowsProductStaging)' != 'true'">
    <Error Text="Publish Windows through publish.cmd -W or Tools\Windows\PublishWindowsProduct.ps1. The product publisher assembles the final DLLs and executables, with optional signing; standalone project publishing is not a release artifact." />
  </Target>
</Project>
