<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AndroidApplication>true</AndroidApplication>
    <AssemblyName>PasswordManagerLocal.Android.Frontend</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Android.Frontend</RootNamespace>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>com.levibaba.passwordmanagerlocal</ApplicationId>
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.3</ApplicationDisplayVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;ARM64;ARM32</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidBuildApplicationPackage>true</AndroidBuildApplicationPackage>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidEnableMarshalMethods>true</AndroidEnableMarshalMethods>
    <AndroidEnablePreloadAssemblies>false</AndroidEnablePreloadAssemblies>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepositoryRoot>
    <PublishArtifactsRoot Condition="'$(PublishArtifactsRoot)' == ''">$(RepositoryRoot)artifacts\publish\</PublishArtifactsRoot>
    <AndroidMinimumVersion Condition="'$(AndroidMinimumVersion)' == ''">10</AndroidMinimumVersion>
    <AndroidArtifactsPublishDir Condition="'$(AndroidArtifactsPublishDir)' == ''">$(PublishArtifactsRoot)PasswordManagerLocal.Android.Frontend\android-$(AndroidMinimumVersion)-plus\$(RuntimeIdentifier)\</AndroidArtifactsPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Frontend\PasswordManagerLocal.Common.Frontend.csproj" />
    <ProjectReference Include="..\Backend\PasswordManagerLocal.Android.Backend.csproj" />
    <ProjectReference Include="..\..\Common\Backend.Hosting\PasswordManagerLocal.Common.Backend.Hosting.csproj" />
    <ProjectReference Include="..\..\Common\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
    <ProjectReference Include="..\Runtime\PasswordManagerLocal.Android.Runtime.csproj" />
  </ItemGroup>

  <Target Name="CopyAndroidPackageToPublishArtifacts"
          AfterTargets="SignAndroidPackage"
          Condition="'$(Configuration)' == 'Release' and '$(AndroidArtifactsPublishDir)' != ''">
    <MakeDir Directories="$(AndroidArtifactsPublishDir)" />
    <ItemGroup>
      <AndroidPackageToCopy Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\**\*-signed.apk" />
    </ItemGroup>
    <Copy SourceFiles="@(AndroidPackageToCopy)"
          DestinationFolder="$(AndroidArtifactsPublishDir)"
          SkipUnchangedFiles="false"
          Condition="'@(AndroidPackageToCopy)' != ''" />
    <Message Text="Android package copied to: $(AndroidArtifactsPublishDir)"
             Importance="high"
             Condition="'@(AndroidPackageToCopy)' != ''" />
    <Warning Text="No signed Android APK was found under $(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\."
             Condition="'@(AndroidPackageToCopy)' == ''" />
  </Target>

  <Target Name="BuildAndroidPackageDuringPublish"
          AfterTargets="Publish"
          DependsOnTargets="SignAndroidPackage"
          Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net10.0-android36.0' and '$(RuntimeIdentifier)' != ''">
    <Message Text="Android APK publish completed. Packages are copied to: $(AndroidArtifactsPublishDir)" Importance="high" />
  </Target>
</Project>
