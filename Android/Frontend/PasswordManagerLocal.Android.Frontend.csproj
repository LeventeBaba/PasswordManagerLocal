<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>Password Manager Local</Product>
    <Title>Password Manager Local</Title>
    <OutputType>Exe</OutputType>
    <AndroidApplication>true</AndroidApplication>
    <AssemblyName>PasswordManagerLocal.Android.Frontend</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Android.Frontend</RootNamespace>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
    <ApplicationId>com.levibaba.passwordmanagerlocal</ApplicationId>
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.3</ApplicationDisplayVersion>
    <Version>$(ApplicationDisplayVersion)</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;ARM64;ARM32</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidBuildApplicationPackage>true</AndroidBuildApplicationPackage>
    <!-- Release packages never use the SDK debug identity. Secret values are
         resolved by the SDK; publish.cmd supplies them through process env vars. -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidUseApkSigner>true</AndroidUseApkSigner>
    <AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)' == ''">$(RepositoryRoot)PublishKeys\PasswordManagerLocal-release.jks</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' == ''">passwordmanagerlocal</AndroidSigningKeyAlias>
    <AndroidSigningStorePass Condition="'$(AndroidSigningStorePass)' == ''">env:PML_ANDROID_STORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass Condition="'$(AndroidSigningKeyPass)' == ''">env:PML_ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
    <PmlAndroidCertificateSha256 Condition="'$(PmlAndroidCertificateSha256)' == ''">$(PML_ANDROID_CERT_SHA256)</PmlAndroidCertificateSha256>
    <PmlSigningPowerShell Condition="'$(PmlSigningPowerShell)' == ''">powershell.exe</PmlSigningPowerShell>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidEnableMarshalMethods>true</AndroidEnableMarshalMethods>
    <AndroidEnablePreloadAssemblies>false</AndroidEnablePreloadAssemblies>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepositoryRoot>
    <PublishArtifactsRoot Condition="'$(PublishArtifactsRoot)' == ''">$(RepositoryRoot)artifacts\publish\</PublishArtifactsRoot>
    <AndroidMinimumVersion Condition="'$(AndroidMinimumVersion)' == ''">10</AndroidMinimumVersion>
    <AndroidArtifactsPublishDir Condition="'$(AndroidArtifactsPublishDir)' == ''">$(PublishArtifactsRoot)PasswordManagerLocal.Android.Frontend\android-$(AndroidMinimumVersion)-plus\$(RuntimeIdentifier)\</AndroidArtifactsPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <!-- Direct references make the merged Core/Core.Ktx pair explicit in the
         deployable Android app; versions are governed by Directory.Packages.props. -->
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Frontend\PasswordManagerLocal.Common.Frontend.csproj" />
    <ProjectReference Include="..\Backend\PasswordManagerLocal.Android.Backend.csproj" />
    <ProjectReference Include="..\..\Common\Backend.Hosting\PasswordManagerLocal.Common.Backend.Hosting.csproj" />
    <ProjectReference Include="..\..\Common\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
    <ProjectReference Include="..\Runtime\PasswordManagerLocal.Android.Runtime.csproj" />
  </ItemGroup>

  <Target Name="RequireReleaseAndroidPublish" BeforeTargets="Publish;SignAndroidPackage"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Android publishing requires Release configuration and a dedicated release signing key. Debug publishing is forbidden; normal Debug builds remain available for development." />
  </Target>

  <Target Name="ValidateAndroidReleaseSigning"
          BeforeTargets="_ResolveAndroidSigningKey;_Sign"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(AndroidKeyStore)' != 'true'" Text="Android Release packaging requires AndroidKeyStore=true. Debug signing is forbidden." />
    <Error Condition="'$(AndroidUseApkSigner)' != 'true'" Text="Android Release packaging requires AndroidUseApkSigner=true." />
    <Error Condition="'$(AndroidPackageFormat)' != 'apk' or '$(AndroidPackageFormats)' != 'apk'" Text="This release workflow supports signed APKs only." />
    <Error Condition="'$(AndroidCreatePackagePerAbi)' == 'true'" Text="Publish each Android ABI separately through publish.cmd; multi-APK SDK output is not supported by this signing workflow." />
    <Error Condition="!Exists('$(AndroidSigningKeyStore)')" Text="Release keystore missing. Expected $(AndroidSigningKeyStore). Use publish.cmd -A for secure signing prompts." />
    <Error Condition="!$([System.String]::Copy('$(AndroidSigningStorePass)').StartsWith('env:')) and !$([System.String]::Copy('$(AndroidSigningStorePass)').StartsWith('file:'))" Text="AndroidSigningStorePass must use an env: or file: secret reference. Never pass a plaintext password to MSBuild." />
    <Error Condition="!$([System.String]::Copy('$(AndroidSigningKeyPass)').StartsWith('env:')) and !$([System.String]::Copy('$(AndroidSigningKeyPass)').StartsWith('file:'))" Text="AndroidSigningKeyPass must use an env: or file: secret reference. Never pass a plaintext password to MSBuild." />
    <Exec Command="&quot;$(PmlSigningPowerShell)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Tools\Android\TestAndroidReleaseSigning.ps1&quot; -Mode Validate -KeyStore &quot;$(AndroidSigningKeyStore)&quot; -KeyAlias &quot;$(AndroidSigningKeyAlias)&quot; -StorePassReference &quot;$(AndroidSigningStorePass)&quot; -KeyPassReference &quot;$(AndroidSigningKeyPass)&quot; -JavaSdkDirectory &quot;$(JavaSdkDirectory)&quot; -AndroidSdkDirectory &quot;$(AndroidSdkDirectory)&quot; -ApkSignerJar &quot;$(ApkSignerJar)&quot; -ExpectedCertificateSha256 &quot;$(PmlAndroidCertificateSha256)&quot;" />
  </Target>

  <Target Name="VerifyAndroidReleasePackage" AfterTargets="_Sign"
          DependsOnTargets="ValidateAndroidReleaseSigning"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(ApkFileSigned)' == '' or !Exists('$(ApkFileSigned)')" Text="The current build did not produce its expected signed APK." />
    <Exec Command="&quot;$(PmlSigningPowerShell)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Tools\Android\TestAndroidReleaseSigning.ps1&quot; -Mode Verify -KeyStore &quot;$(AndroidSigningKeyStore)&quot; -KeyAlias &quot;$(AndroidSigningKeyAlias)&quot; -StorePassReference &quot;$(AndroidSigningStorePass)&quot; -KeyPassReference &quot;$(AndroidSigningKeyPass)&quot; -ApkPath &quot;$(ApkFileSigned)&quot; -JavaSdkDirectory &quot;$(JavaSdkDirectory)&quot; -AndroidSdkDirectory &quot;$(AndroidSdkDirectory)&quot; -ApkSignerJar &quot;$(ApkSignerJar)&quot; -ExpectedCertificateSha256 &quot;$(PmlAndroidCertificateSha256)&quot;" />
  </Target>

  <Target Name="CopyAndroidPackageToPublishArtifacts"
          AfterTargets="SignAndroidPackage"
          DependsOnTargets="VerifyAndroidReleasePackage"
          Condition="'$(Configuration)' == 'Release' and '$(AndroidArtifactsPublishDir)' != ''">
    <MakeDir Directories="$(AndroidArtifactsPublishDir)" />
    <ItemGroup>
      <AndroidPackageToCopy Include="$(ApkFileSigned)" />
    </ItemGroup>
    <Copy SourceFiles="@(AndroidPackageToCopy)"
          DestinationFolder="$(AndroidArtifactsPublishDir)"
          SkipUnchangedFiles="false"
          Condition="'@(AndroidPackageToCopy)' != ''" />
    <Message Text="Android package copied to: $(AndroidArtifactsPublishDir)"
             Importance="high"
             Condition="'@(AndroidPackageToCopy)' != ''" />
    <Warning Text="No signed Android APK was found under $(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\."
             Condition="'@(AndroidPackageToCopy)' == ''" />
  </Target>

  <Target Name="BuildAndroidPackageDuringPublish"
          AfterTargets="Publish"
          DependsOnTargets="SignAndroidPackage"
          Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net10.0-android36.0' and '$(RuntimeIdentifier)' != ''">
    <Message Text="Android APK publish completed. Packages are copied to: $(AndroidArtifactsPublishDir)" Importance="high" />
  </Target>
</Project>
