<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PasswordManagerLocal.Common.Frontend</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Common.Frontend</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64;x86;ARM64;ARM32</Platforms>
  </PropertyGroup>


  <ItemGroup>
    <!-- Avalonia auto-includes .axaml files for compilation. Keep this broad asset rule
         for JSON/images/etc. without adding each theme XAML file a second time. -->
    <AvaloniaResource Include="Assets\**"
                      Exclude="Assets\**\*.axaml" />
    <AvaloniaResource Remove="Assets\Legal\**" />
    <EmbeddedResource Include="Assets\Legal\*.json">
      <LogicalName>$(RootNamespace).Assets.Legal.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="ReactiveUI.Avalonia" />

    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
    <ProjectReference Include="..\Preferences\PasswordManagerLocal.Common.Preferences.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PasswordManagerLocal.Common.Tests" />
  </ItemGroup>
</Project>
