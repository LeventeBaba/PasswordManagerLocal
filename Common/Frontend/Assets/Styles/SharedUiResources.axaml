<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared touch-size and typography values; values preserve the existing style metrics. -->
  <x:Double x:Key="AppMetric.TouchTarget.Compact">32</x:Double>
  <x:Double x:Key="AppMetric.TouchTarget.CompactAction">36</x:Double>
  <x:Double x:Key="AppMetric.TouchTarget.Standard">40</x:Double>
  <x:Double x:Key="AppMetric.TouchTarget.PrimaryButton">42</x:Double>
  <x:Double x:Key="AppMetric.TouchTarget.Icon">44</x:Double>
  <CornerRadius x:Key="AppMetric.CornerRadius.Control">6</CornerRadius>
  <CornerRadius x:Key="AppMetric.CornerRadius.Card">18</CornerRadius>
  <x:Double x:Key="AppMetric.Icon.Action">18</x:Double>
  <x:Double x:Key="AppTypography.SectionTitle.Size">18</x:Double>
  <x:Double x:Key="AppTypography.PageTitle.Size">28</x:Double>
  <!-- This fixed hue spectrum represents the color-picker input domain, not the app palette. -->
  <LinearGradientBrush x:Key="ColorPickerSpectrumBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="#FFFF3B30" Offset="0" />
    <GradientStop Color="#FFFF9500" Offset="0.17" />
    <GradientStop Color="#FFFFCC00" Offset="0.34" />
    <GradientStop Color="#FF34C759" Offset="0.5" />
    <GradientStop Color="#FF00A7FF" Offset="0.67" />
    <GradientStop Color="#FF5856D6" Offset="0.84" />
    <GradientStop Color="#FFAF52DE" Offset="1" />
  </LinearGradientBrush>
  <!-- Neutral selector outlines keep the spectrum marker visible across every selected color. -->
  <SolidColorBrush x:Key="ColorSpectrumSelectorLightBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ColorSpectrumSelectorDarkBrush" Color="#E4000000" />
</ResourceDictionary>
