<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Text.Primary}" />
    </Style>

    <Style Selector="SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Text.Primary}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Padding" Value="20" />
      <Setter Property="CornerRadius" Value="{StaticResource AppMetric.CornerRadius.Card}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Default}" />
    </Style>

    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Border.Subtle}" />
    </Style>

    <Style Selector="Border.dangerZone">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Status.Danger.Border}" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Status.Danger.Surface}" />
    </Style>

    <Style Selector="Border.deviceStatusIndicator">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Device.Offline}" />
    </Style>

    <Style Selector="Border.deviceStatusIndicator.online">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Device.Online}" />
    </Style>

    <Style Selector="Border.deviceStatusIndicator.blocked">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Device.Blocked}" />
    </Style>

    <Style Selector="Border.passwordStrengthSegment">
      <Setter Property="Background" Value="{DynamicResource AppBrush.PasswordStrength.Inactive}" />
    </Style>

    <Style Selector="Border.passwordStrengthSegment.weak">
      <Setter Property="Background" Value="{DynamicResource AppBrush.PasswordStrength.Weak}" />
    </Style>

    <Style Selector="Border.passwordStrengthSegment.moderate">
      <Setter Property="Background" Value="{DynamicResource AppBrush.PasswordStrength.Moderate}" />
    </Style>

    <Style Selector="Border.passwordStrengthSegment.good">
      <Setter Property="Background" Value="{DynamicResource AppBrush.PasswordStrength.Good}" />
    </Style>

    <Style Selector="Border.passwordStrengthSegment.strong">
      <Setter Property="Background" Value="{DynamicResource AppBrush.PasswordStrength.Strong}" />
    </Style>

    <Style Selector="Border.passwordStrengthSegment.excellent">
      <Setter Property="Background" Value="{DynamicResource AppBrush.PasswordStrength.Excellent}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.PrimaryButton}" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Action.PrimaryForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Standard}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Standard}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Secondary.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Text.Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Default}" />
    </Style>

    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Secondary.HoverSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Emphasis}" />
    </Style>

    <Style Selector="Button.secondary:pressed">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Secondary.PressedSurface}" />
    </Style>

    <Style Selector="Button.contextHelpButton">
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.contextHelpButton TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.informationLink">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.helpTip">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Selection.Border}" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Selection.Background}" />
    </Style>

    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.ghost:pressed">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Pressed}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Secondary.DisabledSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Action.DisabledForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.SubtleStrong}" />
    </Style>

    <Style Selector="Button.ghost:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Primary.DisabledSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Action.DisabledForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Action.Primary.DisabledSurface}" />
    </Style>

    <Style Selector="Button.danger:disabled">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Danger.DisabledSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Action.DisabledForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Action.Danger.DisabledSurface}" />
    </Style>

    <Style Selector="Button.listItemContentButton">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.listItemContentButton:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.mainNavigation">
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Compact}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.mainNavigation:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.HoverBorder}" />
    </Style>

    <Style Selector="Button.mainNavigation.selected">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.SelectedBorder}" />
    </Style>

    <Style Selector="Button.mainNavigation.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.HoverBorder}" />
    </Style>

    <Style Selector="Button.mainNavigation.windowsMainNavigation">
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.mainNavigation.windowsMainNavigation:pointerover">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Muted}" />
    </Style>

    <Style Selector="Button.mainNavigation.windowsMainNavigation.selected">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Selection.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.SelectedBorder}" />
    </Style>

    <Style Selector="Button.mainNavigation.windowsMainNavigation.selected:pointerover">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Selection.Border}" />
    </Style>

    <Style Selector="Button.settingsNavigation">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.settingsNavigation:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.HoverBorder}" />
    </Style>

    <Style Selector="Button.settingsNavigation.selected">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.SelectedBorder}" />
    </Style>

    <Style Selector="Button.mobileMainMenuDropdown">
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Compact}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Subtle}" />
    </Style>

    <Style Selector="Button.mobileMainMenuDropdown:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.HoverBorder}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Standard}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Action.Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Action.DangerForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>


    <Style Selector="ToolTip">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.HoverBorder}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style Selector="Button.iconButton">
      <Setter Property="MinWidth" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="FontSize" Value="{StaticResource AppMetric.Icon.Action}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Keep visibility glyphs centralized; Foreground is inherited from the themed button. -->
    <Style Selector="Button.passwordVisibilityButton PathIcon">
      <Setter Property="Data" Value="{StaticResource ShowPasswordIconGeometry}" />
    </Style>

    <Style Selector="Button.passwordVisibilityButton.passwordVisible PathIcon">
      <Setter Property="Data" Value="{StaticResource HidePasswordIconGeometry}" />
    </Style>

    <Style Selector="PathIcon.actionButtonIcon">
      <Setter Property="Width" Value="{StaticResource AppMetric.Icon.Action}" />
      <Setter Property="Height" Value="{StaticResource AppMetric.Icon.Action}" />
    </Style>

    <Style Selector="PathIcon.smallUiIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Button.searchModeButton">
      <Setter Property="MinWidth" Value="{StaticResource AppMetric.TouchTarget.Compact}" />
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Compact}" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="PathIcon.mediumUiIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>

    <!-- One vector glyph and alignment rule for help, strength, and security information. -->
    <Style Selector="PathIcon.informationIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="PathIcon.largeEmptyStateIcon">
      <Setter Property="Width" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="Height" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
    </Style>

    <Style Selector="Button.passwordStrengthInfoButton">
      <Setter Property="MinWidth" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="Width" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="Height" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.toolbarGroup">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Subtle}" />
    </Style>


    <Style Selector="UserControl.searchToolbar">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="UserControl.compactSearchToolbar">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Border.searchToolbarCard">
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Border.compactSearchCard">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="Border.compactSearchGroup">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button.searchToolbarButton">
      <Setter Property="Width" Value="48" />
      <Setter Property="MinWidth" Value="48" />
    </Style>

    <Style Selector="Button.compactSearchButton">
      <Setter Property="Width" Value="{StaticResource AppMetric.TouchTarget.Standard}" />
      <Setter Property="MinWidth" Value="{StaticResource AppMetric.TouchTarget.Standard}" />
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Standard}" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller.androidComfortableListScroller">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller.androidComfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical">
      <Setter Property="Width" Value="16" />
      <Setter Property="MinWidth" Value="16" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Height" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Height" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical /template/ Rectangle#TrackRect">
      <Setter Property="Fill" Value="{DynamicResource AppBrush.Scrollbar.Track}" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Scrollbar.Thumb}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Compact}" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller.androidComfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical /template/ Thumb">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="{StaticResource AppMetric.TouchTarget.Icon}" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Scrollbar.ThumbHover}" />
    </Style>

    <Style Selector="ScrollViewer.comfortableListScroller /template/ ScrollBar#PART_VerticalScrollBar:vertical /template/ Thumb:pressed">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Scrollbar.ThumbPressed}" />
    </Style>

    <Style Selector="Border.interactiveListItem">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Subtle}" />
    </Style>

    <Style Selector="Border.interactiveListItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Selection.HoverBorder}" />
    </Style>

    <Style Selector="Border.interactiveListItem.hovered">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Selection.HoverBorder}" />
    </Style>

    <Style Selector="Border.interactiveListItem.multiSelected">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Action.Primary}" />
    </Style>

    <Style Selector="Border.interactiveListItem.multiSelected:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Selection.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Navigation.HoverBorder}" />
    </Style>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="{StaticResource AppTypography.PageTitle.Size}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="{StaticResource AppTypography.SectionTitle.Size}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.subtleText">
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Text.Secondary}" />
      <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style Selector="TextBlock.statusInfoText">
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Status.Information}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.statusSuccessText">
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Status.Success}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.descriptionLink">
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Action.Secondary}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="TextBlock.errorText">
      <Setter Property="Foreground" Value="{DynamicResource AppBrush.Status.Danger}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.readableCode">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas, DejaVu Sans Mono, Courier New" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBox.readableCode">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas, DejaVu Sans Mono, Courier New" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</Styles>
