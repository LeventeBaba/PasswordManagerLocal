<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:info="clr-namespace:PasswordManagerLocal.Common.Frontend.Information"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Profile.ProfileDeleteAccountView"
    x:DataType="vm:ProfileViewModel">
  <ScrollViewer Classes="comfortableListScroller"
                Classes.androidComfortableListScroller="{Binding IsAndroidUi}">
  <StackPanel Spacing="12">
    <Border Classes="card dangerZone">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button
              Classes="ghost iconButton"
              Command="{Binding BackToProfileCommand}"

              ToolTip.Tip="{Binding BackToProfileLabel}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
          <TextBlock
              Text="{Binding DeleteAccountLabel}"
              Classes="sectionTitle"
              VerticalAlignment="Center"
              TextWrapping="Wrap"
              Foreground="{DynamicResource AppBrush.Status.Danger}" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock
              Text="{Binding DeleteAccountWarningTitle}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AppBrush.Status.Danger}"
              TextWrapping="Wrap" />
          <TextBlock Text="{Binding DeleteAccountFinalWarning}" TextWrapping="Wrap" />
          <controls:ContextHelpButton Classes="secondary" MinHeight="44"
                                      HorizontalContentAlignment="Stretch"
                                      TopicId="{x:Static info:HelpTopicIds.DeleteAccount}"
                                      AutomationProperties.Name="{Binding DeleteAccountHelpLabel}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsHitTestVisible="False">
              <PathIcon Classes="smallUiIcon" Data="{StaticResource InformationIconGeometry}" />
              <TextBlock Grid.Column="1" Text="{Binding DeleteAccountHelpLabel}" TextWrapping="Wrap" />
            </Grid>
          </controls:ContextHelpButton>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding CurrentPasswordLabel}" Classes="subtleText" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox MinWidth="0"
                     Text="{Binding DeleteAccountPassword}"
                     PasswordChar="●"
                     RevealPassword="{Binding IsDeleteAccountPasswordVisible}"
                     PlaceholderText="{Binding DeleteAccountPasswordPlaceholder}"
                     TextInputOptions.ContentType="Password"
                     TextInputOptions.IsSensitive="True"
                     TextInputOptions.AutoCapitalization="False"
                     TextInputOptions.ShowSuggestions="False"
                     TextInputOptions.ReturnKeyType="Done">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding DeleteAccountCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Classes="ghost iconButton passwordVisibilityButton"
                    Classes.passwordVisible="{Binding IsDeleteAccountPasswordVisible}"
                    Command="{Binding ToggleDeleteAccountPasswordVisibilityCommand}"
                    ToolTip.Tip="{Binding DeleteAccountPasswordVisibilityToggleText}"
                    AutomationProperties.Name="{Binding DeleteAccountPasswordVisibilityToggleText}">
              <PathIcon Classes="mediumUiIcon" />
            </Button>
          </Grid>
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <Button
              Classes="danger"
              Command="{Binding DeleteAccountCommand}"
              Content="{Binding DeleteAccountLabel}"
              Margin="0,0,8,8" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
