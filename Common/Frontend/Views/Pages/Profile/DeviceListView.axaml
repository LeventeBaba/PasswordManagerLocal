<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Profile.DeviceListView"
    x:DataType="vm:ProfileViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="12">
    <Border Classes="card" IsVisible="{Binding IsDeviceListEmpty}">
      <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="520">
        <PathIcon Classes="largeEmptyStateIcon" Data="{StaticResource AddIconGeometry}" HorizontalAlignment="Center" />
        <TextBlock
            Text="{Binding DevicesEmptyTitle}"
            Classes="sectionTitle"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            Text="{Binding DevicesEmptyDescription}"
            Classes="subtleText"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            Classes="primary"
            HorizontalAlignment="Center"
            Command="{Binding BeginAddDeviceCommand}"
            Content="{Binding AddDeviceLabel}" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding IsDeviceSearchResultEmpty}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding DeviceSearchEmptyTitle}" Classes="sectionTitle" />
        <TextBlock Text="{Binding DeviceSearchEmptyDescription}" Classes="subtleText" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    </StackPanel>
    <ScrollViewer x:Name="DeviceListScrollViewer" Grid.Row="1" Classes="comfortableListScroller"
                  Classes.androidComfortableListScroller="{Binding IsAndroidUi}"
                 >
        <ItemsControl ItemsSource="{Binding Devices}" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DeviceItemViewModel">
          <Border
              Classes="interactiveListItem"
              PointerEntered="InteractiveListItem_PointerEntered"
              PointerExited="InteractiveListItem_PointerExited"
              PointerPressed="InteractiveListItem_PointerPressed"
              PointerReleased="InteractiveListItem_PointerReleased"
              Margin="0,0,0,8"
              Padding="14"
              CornerRadius="16"
              HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="12" HorizontalAlignment="Stretch" PointerEntered="InteractiveListItem_PointerEntered">
              <Border
                  Grid.Column="0"
                  Classes="deviceStatusIndicator"
                  Classes.online="{Binding IsOnline}"
                  Classes.blocked="{Binding IsBlocked}"
                  CornerRadius="6"
                  MinHeight="52" />
              <Button
                  Grid.Column="1"
                  Classes="listItemContentButton"
                  PointerEntered="InteractiveListItem_PointerEntered"
                  Command="{Binding Owner.ViewDeviceCommand}"
                  CommandParameter="{Binding}">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Border
                        Padding="10,4"
                        CornerRadius="10"
                        Background="{DynamicResource AppBrush.Selection.Background}"
                        BorderBrush="{DynamicResource AppBrush.Action.Primary}"
                        BorderThickness="1"
                        IsVisible="{Binding IsCurrentDevice}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                      <TextBlock
                          Text="{Binding CurrentDeviceLabel}"
                          FontSize="12"
                          FontWeight="Bold"
                          Foreground="{DynamicResource AppBrush.Action.Secondary}" />
                    </Border>
                    <TextBlock Text="  •  " Classes="subtleText" IsVisible="{Binding ShowNotTrustedStatus}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NotTrustedLabel}" Classes="subtleText" IsVisible="{Binding ShowNotTrustedStatus}" VerticalAlignment="Center" />
                  </WrapPanel>
                  <WrapPanel>
                    <Border Padding="8,3" CornerRadius="10" Background="{DynamicResource AppBrush.Surface.Badge}" Margin="0,0,6,6">
                      <TextBlock Text="{Binding DeviceTypeText}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border
                        Padding="8,3"
                        CornerRadius="10"
                        Background="{DynamicResource AppBrush.Device.Blocked.Surface}"
                        IsVisible="{Binding IsBlocked}"
                        Margin="0,0,6,6">
                      <TextBlock
                          Text="{Binding BlockedLabel}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource AppBrush.Device.Blocked}" />
                    </Border>
                    <Border Padding="8,3" CornerRadius="10" Background="{DynamicResource AppBrush.Surface.Badge}" Margin="0,0,6,6">
                      <TextBlock Text="{Binding SyncStateText}" FontSize="12" />
                    </Border>
                    <Border
                        Padding="8,3"
                        CornerRadius="10"
                        Background="{DynamicResource AppBrush.Device.Online.Surface}"
                        IsVisible="{Binding ShowOnlineStatus}"
                        Margin="0,0,6,6">
                      <TextBlock
                          Text="{Binding OnlineStateText}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource AppBrush.Device.Online}" />
                    </Border>
                    <Border
                        Padding="8,3"
                        CornerRadius="10"
                        Background="{DynamicResource AppBrush.Device.Offline.Surface}"
                        IsVisible="{Binding ShowOfflineStatus}"
                        Margin="0,0,6,6">
                      <TextBlock
                          Text="{Binding OnlineStateText}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource AppBrush.Device.Offline}" />
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </Button>
              <ToggleSwitch
                  Grid.Column="2"
                  PointerEntered="InteractiveListItem_PointerEntered"
                  IsChecked="{Binding IsSyncOn, Mode=OneWay}"
                  Command="{Binding Owner.ToggleDeviceSyncCommand}"
                  CommandParameter="{Binding}"
                  OnContent="{Binding SyncToggleOnLabel}"
                  OffContent="{Binding SyncToggleOffLabel}"
                  VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
