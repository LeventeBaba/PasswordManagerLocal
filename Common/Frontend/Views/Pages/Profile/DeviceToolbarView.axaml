<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Profile.DeviceToolbarView"
    x:DataType="vm:ProfileViewModel"
    Classes="searchToolbar"
    Classes.compactSearchToolbar="{Binding IsAndroidUi}"
    IsVisible="{Binding IsDeviceToolbarVisible}">
  <Border Classes="card searchToolbarCard"
          Classes.compactSearchCard="{Binding IsAndroidUi}"
          IsVisible="{Binding IsDeviceToolbarVisible}">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MaxWidth="560" HorizontalAlignment="Center">
      <Border Classes="toolbarGroup searchToolbarGroup"
              Classes.compactSearchGroup="{Binding IsAndroidUi}"
              Grid.Column="0"
              MinWidth="0">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinWidth="0">
          <Button
              Classes="ghost searchModeButton"
              ToolTip.Tip="{Binding DeviceSearchModeLabel}">
            <PathIcon Classes="smallUiIcon" Data="{StaticResource SearchIconGeometry}" VerticalAlignment="Center" />
            <Button.Flyout>
              <Flyout>
                <Border Classes="card" Padding="10" MinWidth="210">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock
                          Text="{Binding DeviceSearchModeNameLabel}"
                          VerticalAlignment="Center" />
                      <ToggleSwitch
                          Grid.Column="1"
                          IsChecked="{Binding IsDeviceSearchNameEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanToggleDeviceSearchName}"
                          MinWidth="0"
                          OnContent="{Binding DeviceSwitchOnLabel}"
                          OffContent="{Binding DeviceSwitchOffLabel}"
                          AutomationProperties.Name="{Binding DeviceSearchModeNameLabel}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock
                          Text="{Binding DeviceSearchModeTypeLabel}"
                          VerticalAlignment="Center" />
                      <ToggleSwitch
                          Grid.Column="1"
                          IsChecked="{Binding IsDeviceSearchTypeEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanToggleDeviceSearchType}"
                          MinWidth="0"
                          OnContent="{Binding DeviceSwitchOnLabel}"
                          OffContent="{Binding DeviceSwitchOffLabel}"
                          AutomationProperties.Name="{Binding DeviceSearchModeTypeLabel}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <controls:WatermarkWidthTextBox
              Grid.Column="1"
              Text="{Binding DeviceSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              PlaceholderText="{Binding DeviceSearchPlaceholder}"
              MinWidth="0"
              TextInputOptions.ContentType="Search"
              TextInputOptions.AutoCapitalization="False"
              TextInputOptions.ReturnKeyType="Search">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchDevicesCommand}" />
            </TextBox.KeyBindings>
          </controls:WatermarkWidthTextBox>
        </Grid>
      </Border>
      <Button
          Classes="ghost iconButton searchToolbarButton"
          Classes.compactSearchButton="{Binding IsAndroidUi}"
          Grid.Column="1"
          ToolTip.Tip="{Binding DeviceSortLabel}">
        <PathIcon Classes="actionButtonIcon" Data="{StaticResource SortIconGeometry}" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem
                Header="{Binding DeviceSortNameAscMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="name-asc" />
            <MenuItem
                Header="{Binding DeviceSortNameDescMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="name-desc" />
            <Separator />
            <MenuItem
                Header="{Binding DeviceSortStatusOnlineFirstMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="status-online-first" />
            <MenuItem
                Header="{Binding DeviceSortStatusIssuesFirstMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="status-issues-first" />
            <Separator />
            <MenuItem
                Header="{Binding DeviceSortLinkedNewestMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="linked-desc" />
            <MenuItem
                Header="{Binding DeviceSortLinkedOldestMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="linked-asc" />
            <MenuItem
                Header="{Binding DeviceSortLastSyncNewestMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="last-sync-desc" />
            <MenuItem
                Header="{Binding DeviceSortLastSyncOldestMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="last-sync-asc" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button
          Classes="primary iconButton searchToolbarButton"
          Classes.compactSearchButton="{Binding IsAndroidUi}"
          Grid.Column="2"
          Command="{Binding BeginAddDeviceCommand}"
          ToolTip.Tip="{Binding AddDeviceLabel}">
        <PathIcon Classes="actionButtonIcon" Data="{StaticResource AddIconGeometry}" />
      </Button>
    </Grid>
  </Border>
</UserControl>
