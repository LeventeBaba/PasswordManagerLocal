<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.PasswordListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    xmlns:passwords="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Pages.Passwords"
    x:DataType="vm:PasswordsViewModel">

  <UserControl.Styles>
    <Style Selector="Grid.passwordPaneContent">
      <Setter Property="Margin" Value="16,4,16,16" />
    </Style>
    <Style Selector="Grid.passwordPaneContent.editorPane">
      <Setter Property="Margin" Value="12,4,12,12" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:PasswordListPaneTransitionViewModel">
      <passwords:PasswordListPaneView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:PasswordEditorPaneTransitionViewModel">
      <passwords:PasswordEditorView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:PasswordCustomColorListPaneTransitionViewModel">
      <passwords:CustomColorListView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:PasswordColorPaneTransitionViewModel">
      <passwords:PasswordColorPickerView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:PasswordTagListPaneTransitionViewModel">
      <passwords:PasswordTagListView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:PasswordTagEditorPaneTransitionViewModel">
      <passwords:PasswordTagEditorView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:PasswordDetailsPaneTransitionViewModel">
      <passwords:PasswordDetailsView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:PasswordExportTargetPaneTransitionViewModel">
      <passwords:ExportTargetSelectionView DataContext="{Binding Owner}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>
    <Grid x:Name="PasswordPaneContent" RowDefinitions="Auto,*,Auto"
          Classes="passwordPaneContent" Classes.editorPane="{Binding IsEditorPaneVisible}"
          IsEnabled="{Binding IsPasswordPaneContentEnabled}">
      <passwords:PasswordToolbarView Grid.Row="0" />

      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <controls:OperationMessageView Grid.Row="0" Margin="0,0,0,12" IsVisible="{Binding IsOuterPasswordErrorVisible}" />
        <controls:AdaptiveTransitioningContentControl Grid.Row="1"
            Content="{Binding CurrentPaneViewModel}"
            AnimationsEnabled="{Binding EffectiveInterfaceAnimationsEnabled}"
            IsTransitionReversed="{Binding IsPaneTransitionReversed}" />
      </Grid>

      <Border
          Grid.Row="2"
          Classes="card"
          IsVisible="{Binding IsMultiSelectionToolbarVisible}"
          HorizontalAlignment="Center"
          Margin="0,8,0,0"
          Padding="10,8"
          CornerRadius="16">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <Button
              Grid.Column="0"
              Classes="ghost iconButton"
              Command="{Binding CancelMultiSelectionCommand}"
              ToolTip.Tip="{Binding MultiSelectionCancelLabel}"
              AutomationProperties.Name="{Binding MultiSelectionCancelLabel}">
            <PathIcon Classes="actionButtonIcon" Data="{StaticResource BackIconGeometry}" />
          </Button>

          <Button
              Grid.Column="1"
              Classes="ghost iconButton"
              Command="{Binding SelectAllMultiSelectionCommand}"
              ToolTip.Tip="{Binding MultiSelectionSelectAllLabel}"
              AutomationProperties.Name="{Binding MultiSelectionSelectAllLabel}">
            <Grid>
              <PathIcon
                  Classes="actionButtonIcon"
                  Data="{StaticResource SelectAllIconGeometry}"
                  IsVisible="{Binding IsSelectAllMultiSelectionAction}" />
              <PathIcon
                  Classes="actionButtonIcon"
                  Data="{StaticResource DeselectAllIconGeometry}"
                  IsVisible="{Binding IsDeselectAllMultiSelectionAction}" />
            </Grid>
          </Button>

          <Button
              Grid.Column="2"
              Classes="ghost iconButton"
              Command="{Binding ExportMultiSelectionCommand}"
              IsEnabled="{Binding CanExportMultiSelectionItems}"
              ToolTip.ShowOnDisabled="True"
              ToolTip.Tip="{Binding MultiSelectionExportToolTip}"
              AutomationProperties.Name="{Binding MultiSelectionExportLabel}"
              AutomationProperties.HelpText="{Binding MultiSelectionExportToolTip}">
            <PathIcon Classes="actionButtonIcon" Data="{StaticResource ExportIconGeometry}" />
          </Button>

          <Button
              Grid.Column="3"
              Classes="danger iconButton"
              Command="{Binding BeginDeleteMultiSelectionCommand}"
              IsEnabled="{Binding HasSelectedMultiSelectionItems}"
              ToolTip.ShowOnDisabled="True"
              ToolTip.Tip="{Binding MultiSelectionDeleteToolTip}"
              AutomationProperties.Name="{Binding MultiSelectionDeleteLabel}"
              AutomationProperties.HelpText="{Binding MultiSelectionDeleteToolTip}">
            <PathIcon Classes="actionButtonIcon" Data="{StaticResource DeleteIconGeometry}" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="TagPickerOverlay" IsVisible="{Binding IsPasswordTagPickerVisible}"
            Background="{DynamicResource AppBrush.Dialog.Overlay}" SizeChanged="OnTagPickerOverlaySizeChanged">
      <passwords:PasswordTagPickerView x:Name="TagPickerSurface" DataContext="{Binding TagPicker}" />
    </Border>

    <Border IsVisible="{Binding IsEditorDiscardConfirmationOpen}" Background="{DynamicResource AppBrush.Dialog.Overlay}">
      <Border Classes="card" MaxWidth="460" MaxHeight="640" Margin="16"
              HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding EditorDiscardTitle}" Classes="sectionTitle" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EditorDiscardMessage}" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
            <Button x:Name="KeepEditingButton" Classes="secondary" Command="{Binding KeepEditingPasswordCommand}"
                    Content="{Binding EditorKeepEditingLabel}" Margin="0,0,8,8" MinHeight="48" />
            <Button Classes="danger" Command="{Binding ConfirmDiscardPasswordEditorCommand}"
                    Content="{Binding EditorDiscardLabel}" Margin="0,0,0,8" MinHeight="48" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <passwords:PasswordDeleteDialogView />
    <passwords:CustomColorDeleteDialogView />
    <passwords:PasswordTagDeleteDialogView />
    <passwords:ExportConfirmationDialogView />
  </Grid>
</UserControl>
