<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Passwords.PasswordEditorView"
    x:DataType="vm:PasswordsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.passwordEditorCard">
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.passwordEditorCard.androidEditor">
      <Setter Property="Padding" Value="12" />
    </Style>
  </UserControl.Styles>
  <Border Classes="card passwordEditorCard" Classes.androidEditor="{Binding IsAndroidUi}"
          MaxWidth="760" HorizontalAlignment="Stretch">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsEnabled="{Binding IsEditorInteractive}" IsVisible="{Binding IsEditorHeaderVisible}">
        <Button Classes="ghost iconButton" Command="{Binding CancelPasswordEditorCommand}"
                ToolTip.Tip="{Binding BackToListLabel}" AutomationProperties.Name="{Binding BackToListLabel}">
          <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding EditorTitle}" Classes="sectionTitle"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>

      <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="1"
                    Classes="comfortableListScroller" Classes.androidComfortableListScroller="{Binding IsAndroidUi}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" IsEnabled="{Binding IsEditorInteractive}" Margin="0,0,4,4">
          <controls:OperationMessageView />
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding NameLabel}" Classes="subtleText" />
            <TextBox x:Name="EditorNameTextBox"
                     Text="{Binding EditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding EditorNamePlaceholder}" MaxLength="{Binding EditorNameMaxLength}"
                     AutomationProperties.Name="{Binding NameLabel}"
                     AutomationProperties.HelpText="{Binding EditorNameValidationMessage}"
                     MinWidth="0" MinHeight="44" HorizontalAlignment="Stretch"
                     TextInputOptions.ContentType="Name" TextInputOptions.AutoCapitalization="True"
                     TextInputOptions.ReturnKeyType="Next" />
            <TextBlock Text="{Binding EditorNameValidationMessage}" IsVisible="{Binding HasEditorNameValidationError}"
                       Foreground="{DynamicResource AppBrush.Status.Danger}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="2">
              <TextBlock Text="{Binding PasswordLabel}" Classes="subtleText" VerticalAlignment="Center" />
              <controls:PasswordStrengthInfoButton Grid.Column="1"
                  IsVisible="{Binding IsEditorPasswordStrengthVisible}"
                  Title="{Binding PasswordStrengthInfoTitle}" Body="{Binding PasswordStrengthInfoBody}"
                  AccessibleLabel="{Binding PasswordStrengthInfoAccessibleLabel}" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanRevealEditorStoredPassword}">
              <Border MinHeight="44" Padding="12,0" Background="{DynamicResource AppBrush.Surface.Input}"
                      BorderBrush="{DynamicResource AppBrush.Scrollbar.Thumb}" BorderThickness="1" CornerRadius="6">
                <TextBlock Text="••••••••" Classes="subtleText" VerticalAlignment="Center" />
              </Border>
              <Button Grid.Column="1" Classes="secondary" Command="{Binding RevealEditorPasswordCommand}"
                      MinHeight="44" MaxWidth="170" AutomationProperties.Name="{Binding RevealEditorPasswordLabel}">
                <TextBlock Text="{Binding RevealEditorPasswordLabel}" TextWrapping="Wrap" TextAlignment="Center" />
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" IsVisible="{Binding IsEditorPasswordFieldVisible}">
              <TextBox x:Name="EditorPasswordTextBox"
                       Text="{Binding EditorPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="{Binding EditorPasswordMaskCharacter}"
                       PlaceholderText="{Binding EditorPasswordPlaceholder}" MinWidth="0" MinHeight="44"
                       HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PasswordLabel}"
                       AutomationProperties.HelpText="{Binding EditorPasswordValidationMessage}"
                       TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True"
                       TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False"
                       TextInputOptions.ReturnKeyType="Next" />
              <Button Grid.Column="1" Classes="ghost iconButton" Command="{Binding GenerateEditorPasswordCommand}"
                      ToolTip.Tip="{Binding GeneratePasswordLabel}" AutomationProperties.Name="{Binding GeneratePasswordLabel}">
                <PathIcon Classes="actionButtonIcon" Data="{StaticResource GeneratePasswordIconGeometry}" />
              </Button>
              <Button Grid.Column="2" Classes="ghost iconButton passwordVisibilityButton"
                      Command="{Binding ToggleEditorPasswordVisibilityCommand}"
                      Classes.passwordVisible="{Binding IsEditorPasswordVisible}"
                      ToolTip.Tip="{Binding EditorPasswordVisibilityToggleText}"
                      AutomationProperties.Name="{Binding EditorPasswordVisibilityToggleText}">
                <PathIcon Classes="mediumUiIcon" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding EditorPasswordValidationMessage}" IsVisible="{Binding HasEditorPasswordValidationError}"
                       Foreground="{DynamicResource AppBrush.Status.Danger}" TextWrapping="Wrap" />
            <controls:PasswordStrengthIndicator IsVisible="{Binding IsEditorPasswordStrengthVisible}"
                Strength="{Binding EditorPasswordStrength}" Label="{Binding PasswordStrengthLabel}" />
            <TextBlock Text="{Binding EditorStoredPasswordHint}" IsVisible="{Binding CanRevealEditorStoredPassword}"
                       Classes="subtleText" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding DescriptionLabel}" Classes="subtleText" />
            <TextBox x:Name="EditorDescriptionTextBox"
                     Text="{Binding EditorDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding EditorDescriptionPlaceholder}"
                     MaxLength="{Binding EditorDescriptionMaxLength}" AutomationProperties.Name="{Binding DescriptionLabel}"
                     AcceptsReturn="True" MinHeight="80" MaxHeight="144" TextWrapping="Wrap"
                     TextInputOptions.Multiline="True" TextInputOptions.AutoCapitalization="True"
                     TextInputOptions.ReturnKeyType="Return" />
          </StackPanel>

          <StackPanel Spacing="10">
            <Border Classes="divider" />
            <TextBlock Text="{Binding EditorOrganizationLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <controls:PasswordTagSelectorView x:Name="EditorTagSelector" />
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding ColorLabel}" Classes="subtleText" />
              <ComboBox x:Name="EditorColorComboBox" ItemsSource="{Binding PresetColors}"
                        SelectedItem="{Binding SelectedEditorColorOption, Mode=TwoWay}"
                        SelectionChanged="OnEditorColorSelectionChanged" MinWidth="0" MinHeight="44"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{Binding ColorLabel}">
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="vm:PasswordColorOptionViewModel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinWidth="0">
                      <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                              BorderBrush="{DynamicResource AppBrush.Border.Subtle}"
                              Background="{Binding HexValue, Converter={StaticResource UserColorBrushConverter}}"
                              IsVisible="{Binding IsRegularColorOption}" VerticalAlignment="Center" />
                      <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                              BorderBrush="{DynamicResource AppBrush.Border.Subtle}"
                              Background="{StaticResource ColorPickerSpectrumBrush}"
                              IsVisible="{Binding IsManageColorsOption}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PasswordColorOptionViewModel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                              BorderBrush="{DynamicResource AppBrush.Border.Subtle}"
                              Background="{Binding HexValue, Converter={StaticResource UserColorBrushConverter}}"
                              IsVisible="{Binding IsRegularColorOption}" VerticalAlignment="Center" />
                      <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                              BorderBrush="{DynamicResource AppBrush.Border.Subtle}"
                              Background="{StaticResource ColorPickerSpectrumBrush}"
                              IsVisible="{Binding IsManageColorsOption}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="{DynamicResource AppBrush.Divider}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <Button Classes="primary" Command="{Binding SavePasswordCommand}" IsEnabled="{Binding IsEditorInteractive}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="48"
                AutomationProperties.Name="{Binding EditorSaveActionLabel}">
          <TextBlock Text="{Binding EditorSaveActionLabel}" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
      </Border>
    </Grid>
  </Border>
</UserControl>
