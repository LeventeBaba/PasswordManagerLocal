<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Passwords.PasswordEditorView"
    x:DataType="vm:PasswordsViewModel">
  <ScrollViewer Classes="comfortableListScroller"
                Classes.androidComfortableListScroller="{Binding IsAndroidUi}">
  <StackPanel Spacing="12">
    <Border Classes="card">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button
              Classes="ghost iconButton"
              Command="{Binding CancelPasswordEditorCommand}"

              ToolTip.Tip="{Binding BackToListLabel}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
          <TextBlock
              Text="{Binding EditorTitle}"
              Classes="sectionTitle"
              VerticalAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <Grid
              Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="6">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="{Binding NameLabel}"
                Classes="subtleText" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding ColorLabel}"
                Classes="subtleText" />
            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                Text="{Binding EditorName}"
                PlaceholderText="{Binding EditorNamePlaceholder}"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                TextInputOptions.ContentType="Name"
                TextInputOptions.AutoCapitalization="True" />
            <ComboBox
                x:Name="EditorColorComboBox"
                Grid.Row="1"
                Grid.Column="1"
                ItemsSource="{Binding PresetColors}"
                SelectedItem="{Binding SelectedEditorColorOption, Mode=TwoWay}"
                SelectionChanged="OnEditorColorSelectionChanged"
                Width="136"
                MinWidth="0"
                MaxWidth="136"
                HorizontalAlignment="Right">
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="vm:PasswordColorOptionViewModel">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" MinWidth="0">
                    <Border
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        BorderThickness="1"
                        BorderBrush="#33808080"
                        Background="{Binding Brush}"
                        IsVisible="{Binding IsRegularColorOption}" />
                    <Border
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        BorderThickness="1"
                        BorderBrush="#33808080"
                        IsVisible="{Binding IsManageColorsOption}">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                          <GradientStop Color="#FFFF3B30" Offset="0" />
                          <GradientStop Color="#FFFF9500" Offset="0.17" />
                          <GradientStop Color="#FFFFCC00" Offset="0.34" />
                          <GradientStop Color="#FF34C759" Offset="0.5" />
                          <GradientStop Color="#FF00A7FF" Offset="0.67" />
                          <GradientStop Color="#FF5856D6" Offset="0.84" />
                          <GradientStop Color="#FFAF52DE" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding DisplayName}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PasswordColorOptionViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        BorderThickness="1"
                        BorderBrush="#33808080"
                        Background="{Binding Brush}"
                        IsVisible="{Binding IsRegularColorOption}" />
                    <Border
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        BorderThickness="1"
                        BorderBrush="#33808080"
                        IsVisible="{Binding IsManageColorsOption}">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                          <GradientStop Color="#FFFF3B30" Offset="0" />
                          <GradientStop Color="#FFFF9500" Offset="0.17" />
                          <GradientStop Color="#FFFFCC00" Offset="0.34" />
                          <GradientStop Color="#FF34C759" Offset="0.5" />
                          <GradientStop Color="#FF00A7FF" Offset="0.67" />
                          <GradientStop Color="#FF5856D6" Offset="0.84" />
                          <GradientStop Color="#FFAF52DE" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <TextBlock
                        Text="{Binding DisplayName}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
            <TextBlock Text="{Binding DescriptionLabel}" Classes="subtleText" />
            <TextBox
                Text="{Binding EditorDescription}"
                PlaceholderText="{Binding EditorDescriptionPlaceholder}"
                AcceptsReturn="True"
                MinHeight="92"
                TextWrapping="Wrap"
                TextInputOptions.Multiline="True"
                TextInputOptions.AutoCapitalization="True"
                TextInputOptions.ReturnKeyType="Return" />
          </StackPanel>
          <controls:PasswordTagSelectorView
              Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="2" />
          <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="2" MinHeight="36">
              <TextBlock
                  Grid.Column="0"
                  Text="{Binding PasswordLabel}"
                  Classes="subtleText"
                  VerticalAlignment="Center" />
              <controls:PasswordStrengthInfoButton
                  Grid.Column="1"
                  IsVisible="{Binding IsEditorPasswordStrengthVisible}"
                  Title="{Binding PasswordStrengthInfoTitle}"
                  Body="{Binding PasswordStrengthInfoBody}"
                  AccessibleLabel="{Binding PasswordStrengthInfoAccessibleLabel}"
                  VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <Border
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  IsVisible="{Binding CanRevealEditorStoredPassword}"
                  MinHeight="44"
                  Padding="12,0"
                  Background="#0C808080"
                  BorderBrush="#66808080"
                  BorderThickness="1"
                  CornerRadius="4"
                  IsHitTestVisible="False">
                <TextBlock
                    Text="••••••••"
                    Classes="subtleText"
                    FontSize="16"
                    VerticalAlignment="Center" />
              </Border>
              <TextBox
                  Grid.Column="0"
                  Text="{Binding EditorPassword}"
                  IsVisible="{Binding IsEditorPasswordFieldVisible}"
                  PasswordChar="{Binding EditorPasswordMaskCharacter}"
                  PlaceholderText="{Binding EditorPasswordPlaceholder}"
                  MinWidth="0"
                  HorizontalAlignment="Stretch"
                  TextInputOptions.ContentType="Password"
                  TextInputOptions.IsSensitive="True"
                  TextInputOptions.AutoCapitalization="False"
                  TextInputOptions.ShowSuggestions="False"
                  TextInputOptions.ReturnKeyType="Done" />
              <Button
                  Grid.Column="1"
                  Classes="ghost iconButton"
                  Command="{Binding GenerateEditorPasswordCommand}"
                  IsVisible="{Binding IsEditorPasswordFieldVisible}"
                  ToolTip.Tip="{Binding GeneratePasswordLabel}"
                  AutomationProperties.Name="{Binding GeneratePasswordLabel}">
                <PathIcon
                    Classes="actionButtonIcon"
                    Data="{StaticResource GeneratePasswordIconGeometry}" />
              </Button>
              <Button
                  Grid.Column="2"
                  Classes="ghost"
                  Command="{Binding ToggleEditorPasswordVisibilityCommand}"
                  Content="{Binding EditorPasswordVisibilityToggleText}"
                  IsVisible="{Binding IsEditorPasswordVisibilityToggleVisible}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
              <Button
                  Grid.Column="2"
                  Classes="ghost"
                  Command="{Binding RevealEditorPasswordCommand}"
                  Content="{Binding RevealEditorPasswordLabel}"
                  IsVisible="{Binding CanRevealEditorStoredPassword}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
            </Grid>
            <controls:PasswordStrengthIndicator
                IsVisible="{Binding IsEditorPasswordStrengthVisible}"
                Strength="{Binding EditorPasswordStrength}"
                Label="{Binding PasswordStrengthLabel}" />
            <TextBlock
                Text="{Binding EditorPasswordHint}"
                IsVisible="{Binding IsCreateMode}"
                Classes="subtleText"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <Button
            Classes="primary"
            Command="{Binding SavePasswordCommand}"
            Content="{Binding SavePasswordButtonLabel}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            MinHeight="48" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
      </StackPanel>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
