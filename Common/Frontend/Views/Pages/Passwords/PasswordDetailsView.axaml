<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Passwords.PasswordDetailsView"
    x:DataType="vm:PasswordsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.detailsTagChip">
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#14808080" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <Border Classes="card" IsVisible="{Binding HasSelection}">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button
              Classes="ghost iconButton"
              Command="{Binding BackToListCommand}"
              
              ToolTip.Tip="{Binding BackToListLabel}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
          <TextBlock
              Text="{Binding SelectedPassword.Name}"
              Classes="sectionTitle"
              VerticalAlignment="Center"
              TextWrapping="Wrap"
              Foreground="{Binding SelectedPassword.ColorBrush}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
            <TextBlock Text="{Binding NameLabel}" Classes="subtleText" />
            <TextBlock Text="{Binding SelectedPassword.Name}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding ColorLabel}" Classes="subtleText" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border
                  Width="20"
                  Height="20"
                  CornerRadius="10"
                  Background="{Binding SelectedPassword.ColorBrush}"
                  VerticalAlignment="Center" />
              <Grid VerticalAlignment="Center">
                <StackPanel
                    Spacing="1"
                    IsVisible="{Binding SelectedPassword.HasColorName}">
                  <TextBlock
                      Text="{Binding SelectedPassword.ColorName}"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Text="{Binding SelectedPassword.Color}"
                      Classes="subtleText" />
                </StackPanel>
                <TextBlock
                    Text="{Binding SelectedPassword.Color}"
                    VerticalAlignment="Center"
                    IsVisible="{Binding SelectedPassword.HasNoColorName}" />
              </Grid>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="{Binding DescriptionLabel}" Classes="subtleText" />
            <controls:LinkifiedTextBlock
                SourceText="{Binding SelectedPassword.DescriptionPreview}"
                TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="{Binding DetailsTagsLabel}" Classes="subtleText" />
            <ItemsControl
                ItemsSource="{Binding SelectedPasswordTags}"
                IsVisible="{Binding HasSelectedPasswordTags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PasswordTagItemViewModel">
                  <Border
                      Classes="detailsTagChip"
                      Margin="0,0,6,6"
                      BorderBrush="{Binding ColorBrush}"
                      ToolTip.Tip="{Binding Name}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                      <Ellipse
                          Width="12"
                          Height="12"
                          Fill="{Binding ColorBrush}"
                          Stroke="#55808080"
                          StrokeThickness="1"
                          VerticalAlignment="Center" />
                      <TextBlock
                          Grid.Column="1"
                          Text="{Binding Name}"
                          MaxWidth="220"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Text="{Binding DetailsNoTagsMessage}"
                Classes="subtleText"
                IsVisible="{Binding HasNoSelectedPasswordTags}"
                TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding CreatedAtLabel}" Classes="subtleText" />
              <TextBlock Text="{Binding SelectedPassword.CreatedAtText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding UpdatedAtLabel}" Classes="subtleText" />
              <TextBlock Text="{Binding SelectedPassword.LastUpdatedAtText}" />
            </StackPanel>
          </Grid>
        </Grid>
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="2">
            <TextBlock
                Grid.Column="0"
                Text="{Binding PasswordLabel}"
                Classes="subtleText"
                VerticalAlignment="Center" />
            <controls:PasswordStrengthInfoButton
                Grid.Column="1"
                IsVisible="{Binding HasRevealedPassword}"
                Title="{Binding PasswordStrengthInfoTitle}"
                Body="{Binding PasswordStrengthInfoBody}"
                AccessibleLabel="{Binding PasswordStrengthInfoAccessibleLabel}" />
          </Grid>
          <Border Classes="card" IsVisible="{Binding IsPasswordHidden}">
            <TextBlock Text="{Binding PasswordRevealHint}" Classes="subtleText" TextWrapping="Wrap" />
          </Border>
          <TextBox
              Text="{Binding RevealedPassword, Mode=OneWay}"
              IsVisible="{Binding HasRevealedPassword}"
              IsReadOnly="True"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              TextInputOptions.IsSensitive="True" />
          <controls:PasswordStrengthIndicator
              IsVisible="{Binding HasRevealedPassword}"
              Strength="{Binding RevealedPasswordStrength}"
              Label="{Binding PasswordStrengthLabel}" />
          <WrapPanel Orientation="Horizontal">
            <Button
                Classes="ghost"
                Command="{Binding RevealPasswordCommand}"
                Content="{Binding RevealPasswordLabel}"
                IsVisible="{Binding IsPasswordHidden}"
                Margin="0,0,8,8" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
            <Button
                Classes="ghost"
                Command="{Binding CopyRevealedPasswordCommand}"
                Content="{Binding CopyPasswordLabel}"
                IsVisible="{Binding HasRevealedPassword}"
                Margin="0,0,8,8" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
            <Button
                Classes="ghost"
                Command="{Binding HidePasswordCommand}"
                Content="{Binding HidePasswordLabel}"
                IsVisible="{Binding HasRevealedPassword}"
                Margin="0,0,8,8" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
            <Button
                Classes="ghost"
                Command="{Binding EditSelectedPasswordCommand}"
                ToolTip.Tip="{Binding EditPasswordLabel}"
                Margin="0,0,8,8">
              <PathIcon
                  Classes="actionButtonIcon"
                  Data="{StaticResource EditIconGeometry}" />
            </Button>
            <Button
                Classes="danger"
                Command="{Binding BeginDeleteSelectedPasswordCommand}"
                ToolTip.Tip="{Binding DeletePasswordLabel}"
                AutomationProperties.Name="{Binding DeletePasswordLabel}"
                Margin="0,0,0,8">
              <PathIcon
                  Classes="actionButtonIcon"
                  Data="{StaticResource DeleteIconGeometry}" />
            </Button>
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
