<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Passwords.CustomColorDeleteDialogView"
    x:DataType="vm:PasswordsViewModel"
    IsVisible="{Binding IsCustomColorDeleteConfirmationOpen}">
  <Border Background="#99000000" IsVisible="{Binding IsCustomColorDeleteConfirmationOpen}">
    <Border Classes="card" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding CustomColorDeleteConfirmationTitle}" Classes="sectionTitle" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CustomColorDeleteConfirmationMessage}" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button
              Classes="ghost"
              Command="{Binding CancelDeleteCustomColorCommand}"
              Content="{Binding CancelButtonLabel}"
              Margin="0,0,8,8" />
          <Button
              Classes="danger"
              Command="{Binding ConfirmDeleteCustomColorCommand}"
              Content="{Binding ConfirmDeleteCustomColorLabel}"
              Margin="0,0,0,8" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
