<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
             x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Passwords.PasswordTagPickerView"
             x:DataType="vm:PasswordTagPickerViewModel"
             MaxWidth="560" MaxHeight="640" Margin="12"
             KeyboardNavigation.TabNavigation="Cycle">
  <UserControl.Styles>
    <Style Selector="Button.tagPickerFilter.active">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Selection.Border}" />
    </Style>
    <Style Selector="CheckBox.tagPickerChoice /template/ Grid#PART_RootGrid">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.tagPickerRow">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Surface.Input}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border.Subtle}" />
    </Style>
    <Style Selector="Border.tagPickerRow.checked">
      <Setter Property="Background" Value="{DynamicResource AppBrush.Navigation.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Selection.Border}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="card" Padding="12">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowPickerDetails}">
        <Button x:Name="PickerBackButton" Classes="ghost iconButton" Command="{Binding CancelCommand}"
                AutomationProperties.Name="{Binding CancelLabel}" ToolTip.Tip="{Binding CancelLabel}">
          <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="sectionTitle" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>

      <StackPanel Grid.Row="1" Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
          <TextBox x:Name="TagSearchTextBox"
                   Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="{Binding SearchPlaceholder}" MinWidth="0" MinHeight="44"
                   IsEnabled="{Binding !HasNoTags}" AutomationProperties.Name="{Binding SearchPlaceholder}"
                   TextInputOptions.ContentType="Search" TextInputOptions.AutoCapitalization="False"
                   TextInputOptions.ShowSuggestions="False" TextInputOptions.ReturnKeyType="Search" />
          <Button Grid.Column="1" Classes="ghost iconButton" IsVisible="{Binding HasSearchQuery}"
                  Command="{Binding ClearSearchCommand}" Click="OnClearSearchClick"
                  AutomationProperties.Name="{Binding ClearSearchLabel}" ToolTip.Tip="{Binding ClearSearchLabel}">
            <TextBlock Text="×" FontSize="20" />
          </Button>
        </Grid>
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding ShowPickerDetails}">
          <Button Classes="secondary tagPickerFilter" Classes.active="{Binding ShowAll}"
                  Command="{Binding ShowAllCommand}" Content="{Binding AllLabel}" MinHeight="44" Margin="0,0,6,4" />
          <Button Classes="secondary tagPickerFilter" Classes.active="{Binding ShowSelectedOnly}"
                  Command="{Binding ShowSelectedCommand}" Content="{Binding SelectedLabel}" MinHeight="44" Margin="0,0,6,4" />
          <Button Classes="ghost" Command="{Binding ManageTagsCommand}" Content="{Binding ManageTagsLabel}"
                  MinHeight="44" Margin="0,0,0,4" ToolTip.Tip="{Binding ManagementHint}" />
        </WrapPanel>
      </StackPanel>

      <Grid Grid.Row="2">
        <ScrollViewer x:Name="TagListScrollViewer" IsVisible="{Binding HasTags}"
                      Classes="comfortableListScroller" Classes.androidComfortableListScroller="{Binding IsAndroidUi}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="TagListItems" ItemsSource="{Binding Tags}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PasswordTagPickerItemViewModel">
                <Border Classes="tagPickerRow" Classes.checked="{Binding IsSelected}"
                        BorderThickness="1" CornerRadius="6" Margin="0,0,4,4">
                  <CheckBox Classes="tagPickerChoice" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinHeight="48" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,8,10,8">
                      <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                               Fill="{Binding Color, Converter={StaticResource UserColorBrushConverter}}"
                               Stroke="{DynamicResource AppBrush.Border.Muted}" StrokeThickness="1" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </CheckBox>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding HasNoTags}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="4,12">
            <TextBlock Text="{Binding NoTagsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding NoTagsDescription}" TextWrapping="Wrap" />
            <Button Classes="secondary" Command="{Binding CreateTagCommand}" Content="{Binding CreateTagLabel}" MinHeight="44" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsFilteredEmpty}" HorizontalScrollBarVisibility="Disabled">
          <TextBlock Text="{Binding FilteredEmptyMessage}" TextWrapping="Wrap" Margin="4,12" />
        </ScrollViewer>
      </Grid>

      <StackPanel Grid.Row="3" Spacing="8">
        <TextBlock Text="{Binding RemovedTagsMessage}" IsVisible="{Binding HasRemovedTags}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowColorSuggestion}">
          <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                   Fill="{Binding SuggestedColor, Converter={StaticResource UserColorBrushConverter}}"
                   Stroke="{DynamicResource AppBrush.Border.Muted}" StrokeThickness="1" />
          <TextBlock Grid.Column="1" Text="{Binding ColorSuggestionMessage}" Classes="subtleText" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Button Classes="ghost" Content="{Binding ClearSelectionLabel}" Command="{Binding ClearSelectionCommand}"
                IsVisible="{Binding ShowSelectionActions}" IsEnabled="{Binding HasSelection}" MinHeight="44" HorizontalAlignment="Left" />
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBrush.Divider}" Padding="0,10,0,0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding SelectedCountLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="secondary" Command="{Binding CancelCommand}" Content="{Binding CancelLabel}"
                    IsVisible="{Binding ShowCancelButton}" MinHeight="48" />
            <Button x:Name="PickerDoneButton" Grid.Column="2" Classes="primary" Command="{Binding ApplyCommand}" Content="{Binding DoneLabel}" MinHeight="48" />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
