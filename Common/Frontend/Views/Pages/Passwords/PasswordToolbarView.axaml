<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.Passwords.PasswordToolbarView"
    x:DataType="vm:PasswordsViewModel"
    Classes="searchToolbar"
    Classes.compactSearchToolbar="{Binding IsAndroidPaneTransitionEnabled}"
    IsVisible="{Binding IsListPaneVisible}">
  <Border Classes="card searchToolbarCard"
          Classes.compactSearchCard="{Binding IsAndroidPaneTransitionEnabled}"
          IsVisible="{Binding IsListPaneVisible}">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MaxWidth="560" HorizontalAlignment="Center">
      <Border Classes="toolbarGroup searchToolbarGroup"
              Classes.compactSearchGroup="{Binding IsAndroidPaneTransitionEnabled}"
              Grid.Column="0"
              MinWidth="0">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinWidth="0">
          <Button
              Classes="ghost searchModeButton"
              ToolTip.Tip="{Binding SearchModeLabel}">
            <PathIcon Classes="smallUiIcon" Data="{StaticResource SearchIconGeometry}" VerticalAlignment="Center" />
            <Button.Flyout>
              <Flyout>
                <Border Classes="card" Padding="10" MinWidth="210">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock
                          Text="{Binding SearchModeNameLabel}"
                          VerticalAlignment="Center" />
                      <ToggleSwitch
                          Grid.Column="1"
                          IsChecked="{Binding IsPasswordSearchNameEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanTogglePasswordSearchName}"
                          MinWidth="0"
                          OnContent="{Binding SwitchOnLabel}"
                          OffContent="{Binding SwitchOffLabel}"
                          AutomationProperties.Name="{Binding SearchModeNameLabel}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock
                          Text="{Binding SearchModeDescriptionLabel}"
                          VerticalAlignment="Center" />
                      <ToggleSwitch
                          Grid.Column="1"
                          IsChecked="{Binding IsPasswordSearchDescriptionEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanTogglePasswordSearchDescription}"
                          MinWidth="0"
                          OnContent="{Binding SwitchOnLabel}"
                          OffContent="{Binding SwitchOffLabel}"
                          AutomationProperties.Name="{Binding SearchModeDescriptionLabel}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock
                          Text="{Binding SearchModeTagLabel}"
                          VerticalAlignment="Center" />
                      <ToggleSwitch
                          Grid.Column="1"
                          IsChecked="{Binding IsPasswordSearchTagEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanTogglePasswordSearchTag}"
                          MinWidth="0"
                          OnContent="{Binding SwitchOnLabel}"
                          OffContent="{Binding SwitchOffLabel}"
                          AutomationProperties.Name="{Binding SearchModeTagLabel}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <controls:WatermarkWidthTextBox
              Grid.Column="1"
              Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              PlaceholderText="{Binding SearchPlaceholder}"
              MinWidth="0"
              TextInputOptions.ContentType="Search"
              TextInputOptions.AutoCapitalization="False"
              TextInputOptions.ReturnKeyType="Search">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </controls:WatermarkWidthTextBox>
        </Grid>
      </Border>
      <Button
          Classes="ghost iconButton searchToolbarButton"
          Classes.compactSearchButton="{Binding IsAndroidPaneTransitionEnabled}"
          Grid.Column="1"
          ToolTip.Tip="{Binding SortLabel}">
        <PathIcon Classes="actionButtonIcon" Data="{StaticResource SortIconGeometry}" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem
                Header="{Binding SortNameAscMenuLabel}"
                Command="{Binding SelectSortOptionCommand}"
                CommandParameter="name-asc" />
            <MenuItem
                Header="{Binding SortNameDescMenuLabel}"
                Command="{Binding SelectSortOptionCommand}"
                CommandParameter="name-desc" />
            <MenuItem
                Header="{Binding SortCreatedNewestMenuLabel}"
                Command="{Binding SelectSortOptionCommand}"
                CommandParameter="created-desc" />
            <MenuItem
                Header="{Binding SortCreatedOldestMenuLabel}"
                Command="{Binding SelectSortOptionCommand}"
                CommandParameter="created-asc" />
            <MenuItem
                Header="{Binding SortUpdatedNewestMenuLabel}"
                Command="{Binding SelectSortOptionCommand}"
                CommandParameter="updated-desc" />
            <MenuItem
                Header="{Binding SortUpdatedOldestMenuLabel}"
                Command="{Binding SelectSortOptionCommand}"
                CommandParameter="updated-asc" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button
          Classes="primary iconButton searchToolbarButton"
          Classes.compactSearchButton="{Binding IsAndroidPaneTransitionEnabled}"
          Grid.Column="2"
          Command="{Binding BeginCreatePasswordCommand}"
          ToolTip.Tip="{Binding AddPasswordButtonLabel}">
        <PathIcon Classes="actionButtonIcon" Data="{StaticResource AddIconGeometry}" />
      </Button>
    </Grid>
  </Border>
</UserControl>
