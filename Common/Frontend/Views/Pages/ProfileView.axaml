<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Pages.ProfileView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    xmlns:profile="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Pages.Profile"
    x:DataType="vm:ProfileViewModel">

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:ProfileAccountPageViewModel">
      <profile:ProfileAccountView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:ProfileDevicesPageViewModel">
      <profile:DevicesView DataContext="{Binding Owner}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>
    <Grid RowDefinitions="Auto,*" Margin="16,4,16,16">
      <controls:OperationMessageView Grid.Row="0" Margin="0,0,0,12" />

      <ContentControl Grid.Row="1" Content="{Binding CurrentMainPageViewModel}"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>

    <profile:LocalSyncDialogView />
    <profile:DeviceHistoryRecoveryDialogView />
  </Grid>
</UserControl>
