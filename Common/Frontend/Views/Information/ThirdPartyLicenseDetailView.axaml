<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Information.ThirdPartyLicenseDetailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Common.Frontend.Views.Controls"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Information"
    x:DataType="vm:ThirdPartyLicenseDetailViewModel">

  <ScrollViewer x:Name="PageScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <Grid Margin="16,4,16,16"
          HorizontalAlignment="Stretch">
      <StackPanel Spacing="14"
                  HorizontalAlignment="Stretch">
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Classes="ghost iconButton"
                    Command="{Binding NavigateBackCommand}"
                    ToolTip.Tip="{Binding BackLabel}"
                    AutomationProperties.Name="{Binding BackLabel}">
              <PathIcon Classes="smallUiIcon"
                        Data="{StaticResource BackIconGeometry}" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}"
                         Classes="pageTitle"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Subtitle}"
                         Classes="subtleText"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold" />
              <SelectableTextBlock Text="{Binding Version}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="divider" />
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LicenseLabel}" FontWeight="SemiBold" />
              <SelectableTextBlock Text="{Binding LicenseExpression}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="divider" />
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding PlatformsLabel}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PlatformText}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="divider" />
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding PackagesLabel}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PackageLinksHint}"
                         Classes="subtleText"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasPackages}" />
              <SelectableTextBlock Text="{Binding PackageText}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ShowGeneralSourceLink}" />
              <StackPanel x:Name="PackageLinksPanel"
                          Spacing="8"
                          IsVisible="{Binding HasPackages}" />
            </StackPanel>
            <Border Classes="divider" />
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding CopyrightLabel}" FontWeight="SemiBold" />
              <SelectableTextBlock Text="{Binding CopyrightNotice}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding HasRequiredNotice}">
              <Border Classes="divider" />
              <TextBlock Text="{Binding RequiredNoticeLabel}" FontWeight="SemiBold" />
              <SelectableTextBlock Text="{Binding RequiredNotice}" TextWrapping="Wrap" />
            </StackPanel>
            <controls:ExternalLinkButton Classes="secondary"
                                         ExternalUri="{Binding SourceUri}"
                                         IsVisible="{Binding ShowGeneralSourceLink}"
                                         HorizontalAlignment="Left"
                                         AutomationProperties.Name="{Binding OpenSourcePageLabel}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <TextBlock Text="{Binding OpenSourcePageLabel}"
                           Classes="descriptionLink"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock Text="↗"
                           Classes="descriptionLink"
                           FontWeight="SemiBold"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
            </controls:ExternalLinkButton>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding FullLicenseLabel}"
                       Classes="sectionTitle"
                       TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding LicenseText}"
                                 TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
