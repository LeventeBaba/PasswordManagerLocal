<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Information.ThirdPartyLicensesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Information"
    x:DataType="vm:ThirdPartyLicensesViewModel">

  <ScrollViewer x:Name="PageScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <Grid Margin="16,4,16,16"
          HorizontalAlignment="Stretch">
      <StackPanel Spacing="14"
                  HorizontalAlignment="Stretch">
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Classes="ghost iconButton"
                    Command="{Binding NavigateBackCommand}"
                    ToolTip.Tip="{Binding BackLabel}"
                    AutomationProperties.Name="{Binding BackLabel}">
              <PathIcon Classes="smallUiIcon"
                        Data="{StaticResource BackIconGeometry}" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}"
                         Classes="pageTitle"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Subtitle}"
                         Classes="subtleText"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                       PlaceholderText="{Binding SearchPlaceholder}"
                       AutomationProperties.Name="{Binding SearchPlaceholder}" />
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding ClearSearchCommand}"
                      Content="{Binding ClearSearchLabel}"
                      IsVisible="{Binding HasSearchText}"
                      AutomationProperties.Name="{Binding ClearSearchLabel}" />
            </Grid>
            <TextBlock Text="{Binding ResultSummary}"
                       Classes="subtleText"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ReviewedText}"
                       Classes="subtleText"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding FilteredItems}"
                      IsVisible="{Binding HasResults}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThirdPartyLicenseItemViewModel">
              <Border Classes="card" Margin="0,0,0,10">
                <Button Classes="ghost"
                        Command="{Binding OpenCommand}"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="{Binding Name}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsHitTestVisible="False">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="16"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Version}"
                                 Classes="subtleText"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding LicenseExpression}"
                                 Classes="subtleText"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding PlatformText}"
                                 Classes="subtleText"
                                 FontSize="12"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <PathIcon Grid.Column="1"
                              Classes="mediumUiIcon"
                              Data="{StaticResource ChevronRightIconGeometry}"
                              VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card"
                IsVisible="{Binding HasNoResults}">
          <TextBlock Text="{Binding EmptyResultsText}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
