<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PasswordManagerLocal.Common.Frontend.Views.ConfirmationDialog"
        Width="440"
        SizeToContent="Height"
        MinWidth="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Classes="card" Margin="18">
    <StackPanel Spacing="16">
      <TextBlock x:Name="TitleText" Classes="sectionTitle" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Button x:Name="NoButton"
                Classes="ghost"
                Click="NoButton_Click" />
        <Button x:Name="YesButton"
                Grid.Column="1"
                Classes="primary"
                Click="YesButton_Click" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
