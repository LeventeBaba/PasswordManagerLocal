<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Controls.PasswordStrengthIndicator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
  <StackPanel Spacing="5">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock
          x:Name="StrengthLabelText"
          Grid.Column="0"
          FontSize="12"
          Opacity="0.78"
          TextWrapping="Wrap"
          VerticalAlignment="Center" />
      <TextBlock
          x:Name="StrengthScoreText"
          Grid.Column="1"
          FontSize="12"
          FontWeight="SemiBold"
          Opacity="0.78"
          VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="4">
      <Border x:Name="StrengthSegment1" Classes="passwordStrengthSegment" Grid.Column="0" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment2" Classes="passwordStrengthSegment" Grid.Column="1" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment3" Classes="passwordStrengthSegment" Grid.Column="2" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment4" Classes="passwordStrengthSegment" Grid.Column="3" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment5" Classes="passwordStrengthSegment" Grid.Column="4" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment6" Classes="passwordStrengthSegment" Grid.Column="5" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment7" Classes="passwordStrengthSegment" Grid.Column="6" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment8" Classes="passwordStrengthSegment" Grid.Column="7" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment9" Classes="passwordStrengthSegment" Grid.Column="8" Height="7" CornerRadius="4" />
      <Border x:Name="StrengthSegment10" Classes="passwordStrengthSegment" Grid.Column="9" Height="7" CornerRadius="4" />
    </Grid>
  </StackPanel>
</UserControl>
