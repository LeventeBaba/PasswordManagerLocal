<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Controls.PasswordTagSelectorView"
    x:DataType="vm:PasswordsViewModel"
    LostFocus="OnSelectorLostFocus">
  <UserControl.Styles>
    <Style Selector="Border.tagSelectorFrame">
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#66808080" />
      <Setter Property="Background" Value="#0C808080" />
      <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style Selector="Border.tagChip">
      <Setter Property="Padding" Value="8,4,4,4" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#44808080" />
      <Setter Property="Background" Value="#14808080" />
    </Style>

    <Style Selector="Button.tagRemoveButton">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Width" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tagRemoveButton:pointerover">
      <Setter Property="Background" Value="#20808080" />
    </Style>

    <Style Selector="Button.tagSuggestionButton">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.tagSuggestionButton:pointerover">
      <Setter Property="Background" Value="#14808080" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock
          Text="{Binding EditorTagsLabel}"
          Classes="subtleText"
          VerticalAlignment="Center" />
      <Button
          Grid.Column="1"
          Classes="ghost"
          Content="{Binding EditorManageTagsLabel}"
          Command="{Binding OpenPasswordTagListCommand}"
          MinHeight="32"
          Padding="10,4"
          ToolTip.Tip="{Binding EditorManageTagsLabel}" />
    </Grid>

    <Border Classes="tagSelectorFrame">
      <StackPanel Spacing="6">
        <ItemsControl
            ItemsSource="{Binding EditorSelectedTags}"
            IsVisible="{Binding HasSelectedEditorTags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PasswordTagItemViewModel">
              <Border
                  Classes="tagChip"
                  Margin="0,0,6,6"
                  BorderBrush="{Binding ColorBrush}"
                  ToolTip.Tip="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <Ellipse
                      Width="12"
                      Height="12"
                      Fill="{Binding ColorBrush}"
                      Stroke="#55808080"
                      StrokeThickness="1"
                      VerticalAlignment="Center" />
                  <TextBlock
                      Grid.Column="1"
                      Text="{Binding Name}"
                      MaxWidth="200"
                      TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Center" />
                  <Button
                      Grid.Column="2"
                      Classes="tagRemoveButton"
                      Command="{Binding Owner.RemoveEditorTagCommand}"
                      CommandParameter="{Binding}"
                      Content="×"
                      ToolTip.Tip="{Binding RemoveLabel}"
                      AutomationProperties.Name="{Binding RemoveLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox
            x:Name="TagSearchTextBox"
            Text="{Binding EditorTagSearchQuery, Mode=TwoWay}"
            PlaceholderText="{Binding EditorTagSearchPlaceholder}"
            IsEnabled="{Binding IsEditorTagSearchEnabled}"
            IsVisible="{Binding IsEditorTagSearchEnabled}"
            MinWidth="0"
            HorizontalAlignment="Stretch"
            GotFocus="OnTagSearchGotFocus"
            KeyDown="OnTagSearchKeyDown"
            TextInputOptions.ContentType="Name"
            TextInputOptions.AutoCapitalization="False"
            TextInputOptions.ShowSuggestions="False" />

        <TextBlock
            Text="{Binding EditorNoTagsAvailableMessage}"
            IsVisible="{Binding IsEditorTagEmptyStateVisible}"
            Classes="subtleText"
            Margin="2,4"
            TextWrapping="Wrap" />

        <TextBlock
            Text="{Binding EditorAllTagsSelectedMessage}"
            IsVisible="{Binding IsEditorAllTagsSelectedVisible}"
            Classes="subtleText"
            Margin="2,4"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border
        IsVisible="{Binding IsEditorTagSuggestionPanelVisible}"
        BorderBrush="#44808080"
        BorderThickness="1"
        CornerRadius="6"
        Background="#0C808080"
        Padding="4">
      <StackPanel>
        <ScrollViewer
            IsVisible="{Binding HasEditorTagSuggestions}"
            MaxHeight="280"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding EditorTagSuggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PasswordTagItemViewModel">
                <Button
                    Classes="tagSuggestionButton"
                    Command="{Binding Owner.SelectEditorTagCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding Name}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Fill="{Binding ColorBrush}"
                        Stroke="#55808080"
                        StrokeThickness="1"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock
            Text="{Binding EditorNoMatchingTagsMessage}"
            IsVisible="{Binding IsEditorTagNoMatchesVisible}"
            Classes="subtleText"
            Margin="10,8"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
