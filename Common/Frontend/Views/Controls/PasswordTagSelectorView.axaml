<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels.Pages"
             x:Class="PasswordManagerLocal.Common.Frontend.Views.Controls.PasswordTagSelectorView"
             x:DataType="vm:PasswordsViewModel">
  <Button x:Name="ChooseTagsButton" Classes="secondary" Command="{Binding OpenPasswordTagPickerCommand}"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="64" Padding="12,8"
          AutomationProperties.Name="{Binding EditorChooseTagsLabel}"
          AutomationProperties.HelpText="{Binding EditorTagsAccessibleSummary}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding EditorChooseTagsLabel}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Border Grid.Column="1" IsVisible="{Binding HasSelectedEditorTags}" Padding="6,2" CornerRadius="10"
                  Background="{DynamicResource AppBrush.Surface.Badge}" VerticalAlignment="Center">
            <TextBlock Text="{Binding EditorSelectedTagCount}" AutomationProperties.Name="{Binding EditorTagsAccessibleSummary}" />
          </Border>
        </Grid>
        <TextBlock Text="{Binding EditorTagsSummary}" Classes="subtleText"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <PathIcon Grid.Column="1" Classes="smallUiIcon" Data="{StaticResource ChevronRightIconGeometry}" VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
