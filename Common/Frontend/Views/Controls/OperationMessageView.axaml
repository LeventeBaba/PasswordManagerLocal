<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Common.Frontend.ViewModels"
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Controls.OperationMessageView"
    x:DataType="vm:ViewModelBase"
    IsVisible="{Binding IsStatusMessageError}">
  <Border Classes="card" IsVisible="{Binding IsStatusMessageError}">
    <Grid>
      <TextBlock
          Text="{Binding StatusMessage}"
          Classes="errorText"
          TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
