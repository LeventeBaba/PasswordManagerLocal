<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Controls.PasswordStrengthInfoButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button
      x:Name="InfoButton"
      Classes="passwordStrengthInfoButton">
    <Border
        Width="18"
        Height="18"
        BorderBrush="#B0808080"
        BorderThickness="1.5"
        CornerRadius="9">
      <TextBlock
          Text="i"
          FontSize="13"
          FontWeight="Bold"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          TextAlignment="Center" />
    </Border>
  </Button>
</UserControl>
