<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Common.Frontend.Views.Controls.PasswordStrengthInfoButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button
      x:Name="InfoButton"
      Classes="passwordStrengthInfoButton">
    <PathIcon
        Classes="informationIcon"
        Data="{StaticResource InformationIconGeometry}" />
  </Button>
</UserControl>
