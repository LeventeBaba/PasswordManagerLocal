<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PasswordManagerLocal.Common.Backend</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Common.Backend</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64;ARM64;x86;ARM32</Platforms>
  </PropertyGroup>

  <!-- The EF CLI loads this managed build through the in-memory design-time factory. -->
  <Choose>
    <When Condition="'$(PmlWindowsAgentAotArtifactsPath)' != '' and '$(PmlWindowsAgentAotEfDesignTime)' == 'true'">
      <PropertyGroup>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
      </PropertyGroup>
      <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <Compile Remove="Persistence\AppDbContextDesignTimeFactory.cs" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Compile the generated model and interceptors into the assembly that owns the queries. -->
  <PropertyGroup Condition="'$(PmlWindowsAgentAotArtifactsPath)' != '' and '$(PmlWindowsAgentAotEfSourcesPath)' != ''">
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup Condition="'$(PmlWindowsAgentAotArtifactsPath)' != '' and '$(PmlWindowsAgentAotEfSourcesPath)' != ''">
    <Compile Include="$(PmlWindowsAgentAotEfSourcesPath)\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="NSec.Cryptography" />
  </ItemGroup>


  <ItemGroup>
    <Protobuf Include="Sync\Sync.proto" GrpcServices="None" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
  </ItemGroup>

</Project>
